---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { breadcrumb, webPage } from '../data/schema';
const path = '/accessibility/';
const title = `Accessibility | ${site.name}`;
const description = `How ${site.name} works to make this website usable for everyone, and how to tell us about a problem.`;
---
<Layout title={title} description={description} schema={[webPage(path, title, description), breadcrumb([['Home', '/'], ['Accessibility', path]])]}>
  <section class="section wrap prose">
    <p class="eyebrow">Accessibility</p>
    <h1>Built to be <em>usable by everyone.</em></h1>
    <p>We aim to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA. Work in progress includes:</p>
    <ul>
      <li>A "Skip to content" link and full keyboard navigation, with a visible focus outline.</li>
      <li>Labeled form fields with error messages announced to screen readers.</li>
      <li>Reduced motion when your device asks for it.</li>
      <li>Text alternatives for photos and floor plans, plus downloadable PDFs.</li>
    </ul>
    <h2>Found a problem?</h2>
    <p>Tell us what page and what happened, and we'll fix it or get you the information another way. Call <a href={site.phoneHref}>{site.phone}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>
</Layout>
<style>
  .prose { max-width: 760px; } .prose ul { padding-left: 1.2rem; } .prose a { color: var(--clay); }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); }
</style>
