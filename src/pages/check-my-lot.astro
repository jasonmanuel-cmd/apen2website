---
// Phase 1 interim: scope + current lead form. Phase 2 replaces this with the five-step workflow
// (owned / under contract / looking), durable storage and an opaque receipt (spec §09, §11).
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';
import { breadcrumb, webPage } from '../data/schema';
const path = '/check-my-lot/';
const title = `Check My Lot | ${site.name}`;
const description = `Tell ${site.name} about your land and the home you have in mind. We review the information and discuss next steps. A preliminary review, not a survey or permit approval.`;
---
<Layout title={title} description={description} schema={[webPage(path, title, description), breadcrumb([['Home', '/'], ['Build on your lot', '/build-on-your-lot/'], ['Check My Lot', path]])]}>
  <section class="section wrap grid">
    <div>
      <nav class="mono crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/build-on-your-lot/">Build on your lot</a> / <span aria-current="page">Check My Lot</span></nav>
      <p class="eyebrow">Check My Lot</p>
      <h1>Tell us about <em>your land.</em></h1>
      <p class="lede">Tell us about your land and the home you have in mind. Aspen II can review the information and discuss next steps.</p>
      <p class="limits">This is a preliminary review, not a survey, engineering opinion, permit approval or guarantee that a parcel can be built on. Still looking for land? You don't need a parcel. Unknown answers are fine.</p>
      <p class="muted">In the notes, include the address, APN or a map link if you have one, plus anything you know about access, slope, water, sewer or septic, power, HOA and existing studies.</p>
    </div>
    <LeadForm interest="lot" source="Check My Lot" />
  </section>
</Layout>
<style>
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .crumbs { color: var(--muted); font-size: .68rem; margin-bottom: 2rem; } .crumbs a { text-decoration: none; }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .lede { font-size: 1.15rem; color: var(--muted); }
  .limits { padding: 1rem 1.2rem; border-left: 3px solid var(--gold); background: var(--paper); }
</style>
