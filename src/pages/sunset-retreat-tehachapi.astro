---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, offer, plans, photos, financing, usd, disclaimer } from '../data/site';
import { breadcrumb, faqPage, webPage } from '../data/schema';

// The community page. The 1,715 sq ft floor plan of the same name lives at /sunset-retreat/.
const model = plans.find((p) => p.slug === 'sunset-retreat')!;
const imgs = photos(model.folder);
const og = imgs[0] ? (await getImage({ src: imgs[0].src, width: 1200, format: 'jpg' })).src : undefined;
const path = '/sunset-retreat-tehachapi/';
const title = `Sunset Retreat: New Homes in Tehachapi, CA From ${usd(offer.from)} | ${site.name}`;
const description = `Sunset Retreat is ${site.name}' current release in Tehachapi, CA. First release from ${usd(offer.from)}: the ${model.sqft.toLocaleString()} sq ft Sunset Retreat model, ${model.beds} bed, ${model.baths} bath. Home 1 and Home 2 reserving.`;
const qa: [string, string][] = [
  ['What is Sunset Retreat?', `Sunset Retreat is ${site.name}' current new-home release in Tehachapi, California. The first release homes are the Sunset Retreat model: ${model.sqft.toLocaleString()} sq ft, ${model.beds} bedrooms, ${model.baths} bathrooms, single-story.`],
  ['How much do Sunset Retreat homes cost?', `The first release starts at ${usd(offer.from)}. Ask us what the starting price includes. Pricing and availability are subject to change.`],
  ['How many homes are available?', 'Two homes are in the first release: Home 1 and Home 2 are reserving now. Phase 2 has a waitlist.'],
  ['How long until move-in?', 'First-release homes are estimated at roughly three months to move-in, subject to construction conditions.'],
  ['Can I choose my finishes?', 'Yes. Reserving early lets you personalize finishes such as flooring, paint colors and cabinetry before the home is built. Available choices depend on the construction stage.'],
  ['What financing is available?', `A 0% down option for eligible first-time buyers, FHA, VA and conventional loans, and up to ${usd(offer.earlyCredit)} in early-buyer savings. Eligibility, lender approval and program terms apply.`],
  ['How does reserving work?', 'Contact us and we will walk you through the reservation steps, what they include and what comes next before you commit to anything.'],
];
const schema = [
  webPage(path, title, description, { about: { '@type': 'Place', name: 'Sunset Retreat, Tehachapi, California' }, ...(og && { primaryImageOfPage: { '@type': 'ImageObject', url: new URL(og, site.url).href } }) }),
  breadcrumb([['Home', '/'], ['New homes', path], ['Sunset Retreat, Tehachapi', path]]),
  faqPage(qa),
];
---
<Layout title={title} description={description} schema={schema} image={og}>
  <section class="hero">
    <div class="wrap">
      <nav class="mono crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Sunset Retreat, Tehachapi</span></nav>
      <p class="eyebrow reveal">Current release · {offer.city}</p>
      <h1 class="reveal" style="animation-delay:.1s">New Homes at Sunset Retreat in <em>Tehachapi, California</em></h1>
      <p class="lede reveal" style="animation-delay:.2s">The first two homes at Sunset Retreat are reserving now, from {usd(offer.from)}. Each is the {model.sqft.toLocaleString()} sq ft Sunset Retreat model, and reserving early lets you choose your finishes before it's built.</p>
      <div class="ctas"><a class="btn" href="#reserve">Reserve a home</a><a class="btn btn-ghost" href="#availability">See availability</a></div>
    </div>
  </section>

  <section class="section" id="availability">
    <div class="wrap avail">
      <div>
        <p class="eyebrow">Pricing & availability</p>
        <h2>First release: <em>two homes.</em></h2>
        <table>
          <caption class="mono">Last confirmed {site.verified}. Subject to change without notice.</caption>
          <thead><tr><th>Home</th><th>Status</th></tr></thead>
          <tbody>{offer.release.map(([h, st]) => <tr><th scope="row">{h}</th><td class:list={[{ live: st === 'Reserving' }]}>{st}</td></tr>)}</tbody>
        </table>
      </div>
      <dl class="facts">
        <div><dt class="mono">Starting price</dt><dd>{usd(offer.from)}</dd></div>
        <div><dt class="mono">Model</dt><dd><a href={`/${model.slug}/`}>Sunset Retreat model</a></dd></div>
        <div><dt class="mono">Size</dt><dd>{model.sqft.toLocaleString()} sf · {model.beds} bd · {model.baths} ba</dd></div>
        <div><dt class="mono">Stories</dt><dd>Single</dd></div>
        <div><dt class="mono">Est. move-in</dt><dd>{offer.moveIn}*</dd></div>
        <div><dt class="mono">Location</dt><dd>{offer.city}</dd></div>
      </dl>
    </div>
    <p class="wrap fine">*Estimate, subject to construction conditions. Ask what the starting price includes.</p>
  </section>

  <section class="section wrap">
    <p class="eyebrow">The home</p>
    <h2>The Sunset Retreat <em>model.</em></h2>
    <p class="muted narrow">{model.summary}</p>
    <ul class="hl">{model.highlights.map((h) => <li>{h}</li>)}</ul>
    {imgs.length > 0 && <><p class="mono note">Photography of the Sunset Retreat model plan.</p><Gallery images={imgs} name="Sunset Retreat model" /></>}
    <p class="ctas-row"><a class="btn btn-ghost" href={`/${model.slug}/`}>Floor plan & full specs</a><a class="btn btn-ghost" href={`/plans/${model.slug}.pdf`} target="_blank" rel="noopener">Floor plan PDF</a></p>
  </section>

  <section class="section money">
    <div class="wrap">
      <p class="eyebrow">Financing & incentives</p>
      <h2>Ways to <em>get in.</em></h2>
      <ul class="programs">{financing.programs.map((p) => <li class="mono">{p}</li>)}</ul>
      <p>{financing.disclaimer}</p>
      <p><a class="btn" href="/financing/">See financing details</a></p>
    </div>
  </section>

  <section class="section wrap faq-sec">
    <p class="eyebrow">Sunset Retreat questions</p>
    <h2>Straight <em>answers.</em></h2>
    <div class="faq">{qa.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <section class="section reserve" id="reserve">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Reserve or ask</p>
        <h2>Request current <em>availability.</em></h2>
        <p class="muted">Reserve a home, ask what's included or schedule a call. We reply {site.followUp}.</p>
        <p class="fine">{disclaimer}</p>
      </div>
      <LeadForm plan="Sunset Retreat" community="Tehachapi" interest="reserve" source="Sunset Retreat community page" />
    </div>
  </section>
</Layout>

<style>
  .hero { background: var(--ink) var(--topo-light); background-size: 480px; color: var(--bone); padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 110px); }
  .hero .eyebrow, .hero em { color: var(--gold); }
  .hero h1 { max-width: 20ch; font-size: clamp(2.4rem, 6vw, 4.6rem); }
  .hero h1 em { display: block; }
  .crumbs { color: var(--on-dark-muted); font-size: .68rem; margin-bottom: 2.5rem; } .crumbs a { text-decoration: none; }
  .lede { max-width: 56ch; font-size: 1.2rem; opacity: .92; }
  .ctas, .ctas-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  .avail { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  table { width: 100%; border-collapse: collapse; }
  caption { caption-side: bottom; text-align: left; font-size: .66rem; color: var(--muted); padding-top: .8rem; }
  th, td { text-align: left; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  thead th { font: .68rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  tbody th { font: 400 1.2rem var(--display); }
  td { font: .8rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .live { color: var(--clay); } .live::before { content: "● "; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; margin: 0; background: var(--paper); border: 1px solid var(--line); padding: 1rem 1.5rem; }
  .facts div { padding: .8rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--muted); font-size: .64rem; }
  .facts dd { margin: .3rem 0 0; font: 1.2rem var(--display); }
  .facts a { color: var(--clay); }
  .fine { font-size: .8rem; color: var(--muted); margin-top: 1rem; }
  @media (max-width: 860px) { .avail { grid-template-columns: 1fr; } }
  .narrow { max-width: 60ch; font-size: 1.1rem; }
  .hl { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 2rem; }
  .hl li { border: 1px solid var(--line); background: var(--paper); padding: .45em .9em; font-size: .95rem; }
  .note { font-size: .68rem; color: var(--muted); }
  .money { background: var(--ink) var(--topo-light); background-size: 480px; color: var(--bone); }
  .money em, .money .eyebrow { color: var(--gold); }
  .money p:not(.eyebrow) { max-width: 70ch; color: var(--on-dark-muted); font-size: .95rem; }
  .programs { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0; }
  .programs li { border: 1px solid rgb(var(--bone-rgb) / .25); padding: .45em .9em; font-size: .68rem; }
  .faq { max-width: 860px; margin-top: 1.5rem; }
  .faq details { border-top: 1px solid var(--line); } .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 1.1rem 0; font: 1.15rem var(--display); }
  .faq details p { margin: 0 0 1.2rem; color: var(--muted); }
  .reserve { background: var(--sand-2); }
  .grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
