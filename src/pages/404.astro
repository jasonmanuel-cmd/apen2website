---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title={`Page not found | ${site.name}`} description="This page moved or no longer exists." noindex>
  <section class="section wrap">
    <p class="eyebrow">404</p>
    <h1>This lot is <em>still empty.</em></h1>
    <p class="muted">The page you're looking for moved or doesn't exist.</p>
    <p><a class="btn" href="/#plans">See the floor plans</a></p>
  </section>
</Layout>
