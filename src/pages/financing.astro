---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, offer, financing, usd } from '../data/site';
import { breadcrumb, webPage } from '../data/schema';
const steps = [
  ['Tell us your goals', "Share your budget, timeline and whether you're a first-time buyer. A quick call or form is all it takes."],
  ['We match your programs', 'We line up the 0% down option, early-buyer savings and any credits you qualify for.'],
  ['Reserve & customize', 'Lock your pricing, choose your model and personalize your finishes before it is built.'],
];
const crumbSchema = breadcrumb([['Home', '/'], ['Financing', '/financing/']]);
---
<Layout
  schema={crumbSchema}
  title={`Financing: 0% Down & ${usd(offer.earlyCredit)} Savings | ${site.name}`}
  description={`0% down for eligible first-time buyers, up to ${usd(offer.earlyCredit)} early-buyer savings, 2-1 buydowns and closing credits. FHA, VA & conventional.`}
>
  <section class="hero">
    <div class="wrap">
      <nav class="mono crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Financing</span></nav>
      <p class="eyebrow reveal">Financing & incentives</p>
      <h1 class="reveal" style="animation-delay:.1s">Owning a brand-new home is <em>closer than you think.</em></h1>
      <p class="lede reveal" style="animation-delay:.2s">Between a 0% down option for first-time buyers and up to {usd(offer.earlyCredit)} in early-buyer savings toward your floor plan, we build the path around you.</p>
      <div class="nums reveal" style="animation-delay:.3s">
        <div><p class="n">{offer.downPayment}</p><p class="mono">Down option</p></div>
        <div><p class="n">{usd(offer.earlyCredit)}</p><p class="mono">Toward your plan</p></div>
        <div><p class="n">$459K</p><p class="mono">Plans starting at</p></div>
      </div>
      <p class="notlender mono">We are a home builder, not a lender. Programs are offered by lenders and are subject to eligibility, approval and terms. Last confirmed {site.verified}; subject to change without notice.</p>
      <div class="ctas"><a class="btn" href="#qualify">Ask about 0% down options</a><a class="btn btn-ghost" href={site.phoneHref}>Call {site.phone}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Programs & support</p>
      <h2>Ways we help <em>you close.</em></h2>
      <div class="perks">
        {financing.perks.map(([t, d]) => <article><h3>{t}</h3><p class="muted">{d}</p></article>)}
      </div>
      <p class="caveat">Which homes and lots qualify, who provides each credit, start and end dates, and whether offers can be combined vary by program. Ask us for the current terms in writing before you rely on any incentive.</p>
      <div class="loans">
        <p class="mono">Loan types we work with</p>
        <ul>{financing.programs.map((p) => <li class="mono">{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section how">
    <div class="wrap">
      <p class="eyebrow">Simple steps</p>
      <h2>How it <em>works.</em></h2>
      <ol class="steps">{steps.map(([t, d], i) => <li><span class="mono">Step 0{i + 1}</span><h3>{t}</h3><p class="muted">{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="qualify" id="qualify">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Let's find the number that works</p>
        <h2>See what you <em>qualify for.</em></h2>
        <p>A short conversation tells us which programs you qualify for and how low we can get your cost to own. Prefer to text? <a href={site.sms('FINANCING')}>Text FINANCING to {site.phone}</a>.</p>
      </div>
      <LeadForm interest="financing" source="Financing page" dark />
    </div>
    <p class="wrap fine">{financing.disclaimer}</p>
  </section>
</Layout>

<style>
  .hero { background: var(--sand-2); padding: clamp(32px, 6vw, 80px) 0 clamp(56px, 8vw, 100px); }
  .crumbs { color: var(--muted); font-size: .68rem; margin-bottom: 2.5rem; }
  .crumbs a { text-decoration: none; }
  .hero h1 { max-width: 16ch; }
  .lede { max-width: 56ch; font-size: 1.2rem; color: var(--muted); }
  .nums { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: clamp(1.5rem, 5vw, 4rem); margin: 2.5rem 0; }
  .nums .n { font: clamp(2.4rem, 6vw, 4.2rem)/1 var(--display); color: var(--clay); margin: 0 0 .4rem; }
  .nums .mono { margin: 0; font-size: .66rem; color: var(--muted); }
  @media (max-width: 520px) { .nums { grid-template-columns: 1fr 1fr; } }
  .ctas { display: flex; flex-wrap: wrap; gap: 1rem; }
  .notlender { font-size: .68rem; color: var(--muted); max-width: 70ch; margin: 0 0 1.5rem; line-height: 1.7; }
  .caveat { max-width: 70ch; margin: 2rem 0 0; padding: 1rem 1.2rem; border-left: 3px solid var(--gold); background: var(--paper); }
  .perks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
  .perks article { border: 1px solid var(--line); padding: 1.8rem; }
  .perks h3 { font-size: 1.35rem; }
  .perks p { margin: 0; }
  @media (max-width: 900px) { .perks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .perks { grid-template-columns: 1fr; } }
  .loans { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .loans > .mono { margin: 0; color: var(--muted); font-size: .68rem; }
  .loans ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .loans li { border: 1px solid var(--line); padding: .45em .9em; font-size: .66rem; }
  .how { background: var(--sand-2); }
  .steps { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .steps .mono { color: var(--clay); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
  .qualify { background: var(--ink); color: var(--bone); padding: clamp(64px, 9vw, 110px) 0 40px; }
  .qualify em, .qualify .eyebrow { color: var(--gold); }
  .qualify a { color: var(--gold); }
  .grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .fine { font-size: .75rem; color: #8a8478; margin-top: 3rem; }
</style>
