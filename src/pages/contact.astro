---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, communities, offer } from '../data/site';
import { breadcrumb, webPage } from '../data/schema';
const choices = [
  ['reserve', `Reserve a ${offer.community} home`],
  ['semi', 'Request model pricing'],
  ['financing', 'Ask about financing'],
  ['tour', 'Schedule a tour'],
];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
const crumbSchema = [webPage('/contact/', `Contact ${site.name}`, `Contact ${site.name} in Tehachapi, CA.`, { '@type': 'ContactPage' }), breadcrumb([['Home', '/'], ['Contact', '/contact/']])];
---
<Layout
  schema={crumbSchema}
  title={`Contact & Schedule a Tour | ${site.name}`}
  description={`Reserve a ${offer.community} home, or pick a semi-custom model. Call or text HOMES to ${site.phone} for plans, pricing and tours.`}
>
  <section class="section">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Talk With Aspen II Homes About <em>Your New Home</em></h1>
        <p class="lede">Reserve a {offer.community} home, or choose a semi-custom model. Zero pressure, zero obligation, just information.</p>
        <p class="quick"><a class="btn" href={site.phoneHref}>Call {site.phone}</a><a class="btn btn-ghost" href={site.sms()}>Text HOMES<span class="sr-only"> to {site.phone}</span></a></p>
        <ul class="choices" role="list" aria-label="What can we help with?">
          {choices.map(([key, label]) => <li><a href={`?interest=${key}#form`} data-choice={key}>{label}</a></li>)}
        </ul>
        <h2 class="sr-only">Contact details</h2>
        <dl class="info">
          <div><dt class="mono">Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt class="mono">Address</dt><dd><a href={mapUrl} target="_blank" rel="noopener">{site.address}<span class="sr-only"> (opens map in a new tab)</span></a></dd></div>
          <div><dt class="mono">Hours</dt><dd>{site.hours}</dd></div>
          {site.license && <div><dt class="mono">License</dt><dd>{site.license}</dd></div>}
        </dl>
        <p class="mono serving">Serving {communities.map((c) => c.name).join(' · ')}</p>
      </div>
      <div class="card" id="form" tabindex="-1">
        <h2 class="sr-only">Send us a message</h2>
        <p class="mono k">Quick form · we reply {site.followUp}</p>
        <LeadForm source="Contact page" interest="tour" compact />
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pills pick the dropdown and jump to the form without a page reload. Without JS they stay plain links.
  document.querySelectorAll<HTMLAnchorElement>('a[data-choice]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const select = document.querySelector<HTMLSelectElement>('select[data-interest]');
      const option = select && [...select.options].find((o) => o.dataset.key === a.dataset.choice);
      const form = document.getElementById('form');
      if (!select || !option || !form) return;
      e.preventDefault();
      select.value = option.value;
      history.replaceState(null, '', `?interest=${a.dataset.choice}#form`);
      form.scrollIntoView();
      form.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 44ch; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); }
  .choices { list-style: none; padding: 0; margin: 1.2rem 0 1.5rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .choices a { display: inline-flex; align-items: center; min-height: 44px; border: 1px solid var(--ink); padding: .6em 1.1em; text-decoration: none; font: .75rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .choices a:hover { background: var(--ink); color: var(--bone); }
  .quick { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.2rem 0 0; }
  .info { margin: 2rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .info dt { font-size: .75rem; color: var(--muted); }
  .info dd { margin: .2rem 0 0; font-family: var(--display); font-size: 1.25rem; }
  .info a { text-decoration: none; } .info a:hover { color: var(--clay); }
  @media (max-width: 480px) { .info { grid-template-columns: 1fr; } }
  .serving { font-size: .75rem; color: var(--muted); line-height: 2; }
  .card { background: var(--sand-2); padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--line); }
  #form:focus { outline: none; box-shadow: none; }
  .k { color: var(--clay); font-size: .75rem; margin: 0 0 1.2rem; }
</style>
