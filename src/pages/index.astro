---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PlanCard from '../components/PlanCard.astro';
import LeadForm from '../components/LeadForm.astro';
import HomeMatcherModal from '../components/HomeMatcherModal.astro';
import InteractiveLotMap from '../components/InteractiveLotMap.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import TestimonialMarquee from '../components/TestimonialMarquee.astro';
import { site, plans, communities, offer, paths, financing, faq, photos, usd, sqftRange, areaUrl, serviceAreaNames, buyingSteps, fromShort, earlyShort, availability } from '../data/site';
import { faqPage, webPage } from '../data/schema';

// Each section uses a different photo; exteriors already appear on the model cards.
const pick = (folder: string, caption: string) => photos(folder).find((p) => p.caption === caption)!.src;
// Hero shows the Sunset Retreat model, matching the Sunset Retreat headline and card.
const hero = pick('sunset-retreat', 'Exterior');
// The release card shows the kitchen island view; the split section further down uses the other kitchen photo.
const cardKitchen = pick('sunset-retreat', 'Kitchen, alternate view');
const kitchen = pick('sunset-retreat', 'Kitchen');
const og = await getImage({ src: hero, width: 1200, format: 'jpg' });

const stats = [
  [fromShort, 'Sunset Retreat from'],
  [offer.sqft.toLocaleString('en-US'), 'Sq ft · Sunset Retreat'],
  ['6', 'Home models'],
  [offer.downPayment, 'Down option, eligible buyers'],
  [earlyShort, 'Early savings, up to'],
  [offer.moveIn, 'To move-in'],
];
const why = [
  ['Six floor plans', `${sqftRange()} sq ft, single- and two-story, each with a downloadable floor plan.`],
  ['Semi-custom finishes', 'Choose flooring, paint colors, cabinetry and more, depending on construction stage.'],
  ['Based in Tehachapi', 'A local builder serving Tehachapi and eastern Kern County.'],
  ['Buyer guides', 'Plain-English guides on buyer programs, costs and Tehachapi weather, with the sources listed.'],
];
const trust = [
  `Same owners, building in Tehachapi since ${site.since}`,
  'Local Tehachapi builder',
  'Serving Tehachapi & eastern Kern County',
  'Equal Housing Opportunity',
  ...(site.license ? [site.license] : []),
];
const steps = buyingSteps;
const title = `Tehachapi Home Builder: Sunset Retreat from ${fromShort} | ${site.name}`;
const description = `Sunset Retreat homes in Tehachapi from ${usd(offer.from)}. Six models, ${sqftRange()} sq ft. 0% down options for eligible first-time buyers. Terms apply.`;
const schema = [webPage('/', title, description, { primaryImageOfPage: { '@type': 'ImageObject', url: new URL(og.src, site.url).href } }), faqPage(faq)];
---
<Layout
  title={title}
  description={description}
  image={og.src}
  schema={schema}
>
  <section class="hero">
    <Image src={hero} alt="Sunset Retreat model exterior with the Tehachapi mountains behind it" class="hero-img" loading="eager" fetchpriority="high" widths={[800, 1280, 1600]} sizes="100vw" />
    <div class="shade"></div>
    <div class="wrap hero-grid">
      <div class="copy reveal">
        <div class="hero-live-pill mono"><span class="pulse-dot" aria-hidden="true"></span> Now reserving phase 1 · {offer.community}, {offer.city}</div>
        <h1>{offer.community} homes in Tehachapi <em>from {usd(offer.from)}.</em></h1>
        <p class="lede">Reserve an upcoming new home at {offer.community}, or choose from our six semi-custom floor plans engineered for Tehachapi mountain living.</p>
        <div class="hero-trust-chips mono">
          <span>30+ Years Local Builder</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>CSLB #1004058</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>0% Down Eligible</span>
        </div>
        <p class="asof mono">Pricing and availability change. Contact us to confirm what is available today. <a href="/available-homes/#availability">Current release details <span aria-hidden="true">→</span></a></p>
        <div class="ctas">
          <a class="btn" href="/available-homes/">See Sunset Retreat availability</a>
          <a class="btn btn-ghost" href="/floor-plans/">Compare floor plans</a>
          <HomeMatcherModal />
        </div>
      </div>
      <a class="release-card reveal" style="animation-delay:.4s" href="/available-homes/" aria-label={`First release, ${availability.releaseCount.toLowerCase()} homes: ${offer.community}, from ${usd(offer.from)}`}>
        <Image src={cardKitchen} alt="Kitchen with island in the Sunset Retreat model" widths={[400, 700]} sizes="360px" />
        <div>
          <p class="mono k">First release · {availability.releaseCount.toLowerCase()} {availability.releaseCount === 'One' ? 'home' : 'homes'}</p>
          <p class="name">{offer.community}</p>
          <p class="price">From <strong>{usd(offer.from)}</strong></p>
          <ul>{offer.release.map(([h, s]) => <li class="mono"><span>{h}</span><span class:list={[{ live: s === 'Reserving' }]}>{s}</span></li>)}</ul>
        </div>
      </a>
    </div>
  </section>

  <section class="trust" aria-label="About Aspen II Homes">
    <ul class="wrap">{trust.map((t) => <li class="mono">{t}</li>)}</ul>
  </section>

  <section class="stats" aria-label="At a glance">
    <div class="wrap stat-grid">{stats.map(([n, l]) => <div><p class="stat">{n}</p><p class="mono">{l}</p></div>)}</div>
  </section>

  <!-- Aceternity Bento Showcase -->
  <section class="section bento-section" id="advantage">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">The Aspen Advantage</p>
          <h2>Luxury craftsmanship. <em>Engineered for Tehachapi.</em></h2>
        </div>
        <p class="muted">
          From 0% down first-time buyer financing to semi-custom architectural flexibility, discover why local families have trusted Aspen II Homes for more than three decades.
        </p>
      </div>

      <div class="bento-grid">
        <!-- Bento 1: Featured 2-Col Sunset Retreat -->
        <article class="bento-card bento-col-2 bento-hero bento-dark">
          <Image src={kitchen} alt="Kitchen with island in the Sunset Retreat model" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 65vw" class="bento-bg-img" />
          <div class="bento-shade" aria-hidden="true"></div>
          <div class="bento-content">
            <div class="bento-badge-row">
              <span class="bento-pill mono"><span class="pulse-dot" aria-hidden="true"></span> Phase 1 · Two Homes Reserving</span>
              <span class="bento-price mono">From {usd(offer.from)}</span>
            </div>
            <h3>Sunset Retreat First Release</h3>
            <p class="bento-desc">
              1,715 sq ft single-story living in Tehachapi. Reserve early to personalize your chef's kitchen, custom cabinetry, quartz countertops, and designer flooring before construction.
            </p>
            <div class="bento-specs mono">
              <span>1,715 sq ft</span>
              <span>·</span>
              <span>3 Beds</span>
              <span>·</span>
              <span>2 Baths</span>
              <span>·</span>
              <span>~3 Months to Move-In</span>
            </div>
            <div class="bento-action">
              <a class="btn" href="/available-homes/">See Sunset Retreat Availability →</a>
            </div>
          </div>
        </article>

        <!-- Bento 2: 0% Down Program -->
        <article class="bento-card bento-accent">
          <div class="bento-top-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <p class="bento-kicker mono">Financing Advantage</p>
          <p class="bento-stat">0% Down</p>
          <h3 class="bento-card-title">Eligible First-Time Buyers</h3>
          <p class="bento-sub">
            Own your brand-new home with zero down payment through qualifying financing programs. We also partner with FHA, VA, and conventional lenders.
          </p>
          <div class="bento-tags mono">
            <span>FHA Low Down</span>
            <span>VA Veterans</span>
            <span>Conventional</span>
          </div>
        </article>

        <!-- Bento 3: Up to $15K Early-Buyer Savings -->
        <article class="bento-card bento-highlight">
          <p class="bento-kicker mono">Limited Phase Incentive</p>
          <p class="bento-stat text-gold">Up to $15,000</p>
          <h3 class="bento-card-title">Early-Buyer Savings Credit</h3>
          <p class="bento-sub">
            Reserve early in the phase and apply up to $15,000 directly toward floor plan personalization, interior selections, or financing rate buydowns.
          </p>
          <div class="bento-bottom-cta">
            <a href="/financing/" class="bento-link mono">See Savings Details <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Bento 4: Six Semi-Custom Models -->
        <article class="bento-card">
          <p class="bento-kicker mono">Architectural Freedom</p>
          <p class="bento-stat">6 Models</p>
          <h3 class="bento-card-title">Proven Semi-Custom Layouts</h3>
          <p class="bento-sub">
            1,507 to 2,348 sq ft single- and two-story plans. Every layout includes architectural blueprints and options to tailor finishes to your exact lifestyle.
          </p>
          <div class="bento-bottom-cta">
            <a href="/floor-plans/" class="bento-link mono">Browse All Plans <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Bento 5: Local Builder Heritage -->
        <article class="bento-card bento-dark">
          <p class="bento-kicker mono text-gold">Local Tehachapi Heritage</p>
          <p class="bento-stat text-gold">30+ Years</p>
          <h3 class="bento-card-title">Building in Tehachapi Since 1994</h3>
          <p class="bento-sub">
            Local family leadership for three decades. Licensed general contractor (CSLB #1004058) building to local mountain snow load and climate standards with trusted area craftsmen.
          </p>
          <div class="bento-tags mono bento-tags-dark">
            <span>CSLB #1004058</span>
            <span>BBB A+</span>
            <span>Equal Housing</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Floor Plans Section -->
  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">The model collection</p>
          <h2>Six models. <em>Your finishes.</em></h2>
        </div>
        <p class="muted">Browse photos and renderings where we have them, plus the blueprint for every home, then pick the one that fits your life.</p>
      </div>
      <div class="plan-grid">{plans.map((plan) => <PlanCard plan={plan} />)}</div>
      <p class="compare-link"><a class="btn btn-ghost" href="/floor-plans/#compare"><span aria-hidden="true">⇄</span> Compare all six models side by side</a></p>
    </div>
  </section>

  <!-- Interactive Lot & Homesite Plat Map -->
  <section class="section plat-section" id="plat-map">
    <div class="wrap">
      <InteractiveLotMap />
    </div>
  </section>

  <!-- Before & After Craftsmanship Slider -->
  <section class="section craft-section" id="craftsmanship">
    <div class="wrap">
      <BeforeAfterSlider />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Simple steps</p>
      <h2>How it <em>works.</em></h2>
      <ol class="steps">{steps.map(([t, d], i) => <li><span class="mono">Step 0{i + 1}</span><h3>{t}</h3><p class="muted">{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="section communities" id="communities">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Where we build</p>
          <h2>Based in Tehachapi. <em>Serving the region.</em></h2>
        </div>
        <p class="muted">{site.name} is a local new home builder based in Tehachapi. The same owners have been building homes there since {site.since}, first as {site.originalEntity} and, since {site.incorporated}, as {site.currentEntity}{site.license && ` (${site.license})`}. We know the building regulations, suppliers and subcontractors in the areas we serve.</p>
      </div>
      <div class="comm-grid">
        {communities.filter((c) => c.published).map((c) => <a href={areaUrl(c)} class="comm"><h3>{c.name}</h3><p class="muted">{c.short}</p><span class="mono">Explore <span aria-hidden="true">→</span></span></a>)}
        <a href="/areas/" class="comm"><h3>Other communities</h3><p class="muted">{serviceAreaNames.filter((n) => n !== 'Tehachapi').join(', ')}. Availability confirmed case by case.</p><span class="mono">Areas we serve <span aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Your questions</p>
        <h2>Planning your <em>new home.</em></h2>
        <p class="muted">Still curious? Call <a href={site.phoneHref}>{site.phone}</a> or text HOMES for instant answers.</p>
      </div>
      <div class="faq">
        {faq.map(([q, a, href], i) => <details open={i === 0}><summary>{q}</summary><p>{a} <a href={href} class="more" aria-label={`Full answer: ${q}`}>Full answer <span aria-hidden="true">→</span></a></p></details>)}
      </div>
    </div>
  </section>

  <!-- Testimonials & Proof Marquee -->
  <TestimonialMarquee />

  <section class="section contact" id="contact">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Talk to our team</p>
        <h2>Your brand-new home starts with <em>a conversation.</em></h2>
        <p class="muted">Reserve a {offer.community} home, or ask about our other floor plans. No pressure, just answers.</p>
        <p class="direct mono"><a href={site.phoneHref}>{site.phone}</a><br /><a href={site.sms()}>Text HOMES</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <LeadForm source="Home page" compact />
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; min-height: min(90vh, 880px); min-height: min(90svh, 880px); display: flex; align-items: flex-end; color: var(--bone); overflow: hidden; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: zoom 20s var(--ease) both; }
  @keyframes zoom { from { transform: scale(1.1); } }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(0 0 0 / .66), rgb(0 0 0 / .08) 70%), linear-gradient(180deg, transparent 45%, rgb(0 0 0 / .7)); }
  .hero-grid { position: relative; width: 100%; display: grid; grid-template-columns: 1.4fr minmax(320px, 380px); gap: 3.5rem; align-items: end; padding-bottom: clamp(40px, 8vh, 90px); padding-top: 6rem; }
  .hero-live-pill { display: inline-flex; align-items: center; gap: .6rem; background: rgb(var(--ink-rgb) / .75); backdrop-filter: blur(12px); border: 1px solid rgb(var(--bone-rgb) / .2); color: var(--bone); padding: .45em 1em; border-radius: 30px; font-size: .74rem; margin-bottom: 1.2rem; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: #62E755; box-shadow: 0 0 10px #62E755; animation: pulse 1.6s infinite; }
  .hero-trust-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; font-size: .74rem; color: var(--bone); opacity: .9; margin: 1.2rem 0; }
  .hero-trust-chips span { background: rgb(0 0 0 / .35); backdrop-filter: blur(8px); padding: .3em .65em; border-radius: 2px; border: 1px solid rgb(255 255 255 / .12); }
  .hero-trust-chips .sep { background: none; border: 0; padding: 0; opacity: .5; }
  .hero .eyebrow { color: var(--bone); }
  .hero em { color: var(--bone); }
  .hero h1 { max-width: 15ch; font-size: clamp(2.4rem, 6.4vw, 5.4rem); line-height: 1.06; margin: 0 0 .8rem; }
  .asof { font-size: .75rem; opacity: .85; margin: .5rem 0 0; } .asof a { color: var(--bone); text-decoration: underline; text-underline-offset: 3px; }
  .trust { background: var(--paper); border-bottom: 1px solid var(--line); }
  .trust ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 2rem; padding-top: 1rem; padding-bottom: 1rem; margin: 0 auto; }
  .trust li { font-size: .75rem; color: var(--ink); }
  .trust li::before { content: "✓ " / ""; color: var(--clay); }
  .compare-link { margin-top: 2.5rem; }
  .faq .more { color: var(--clay); white-space: nowrap; }
  .hero h1 em { display: block; }
  .lede { max-width: 50ch; font-size: 1.15rem; line-height: 1.55; opacity: .92; margin: 0 0 1rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .release-card { display: block; background: rgb(var(--ink-rgb) / .92); backdrop-filter: blur(16px); border: 1px solid rgb(var(--bone-rgb) / .16); border-top: 3px solid var(--gold); box-shadow: 0 24px 60px rgb(0 0 0 / .35); text-decoration: none; transition: transform .35s var(--ease), box-shadow .35s var(--ease); border-radius: 4px; overflow: hidden; }
  .release-card:hover { transform: translateY(-4px); box-shadow: 0 30px 70px rgb(0 0 0 / .45); }
  .release-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .release-card > div { padding: 1.2rem 1.4rem 1.4rem; }
  .release-card .k { color: var(--gold); font-size: .75rem; margin: 0; }
  .release-card .name { font: 1.7rem var(--display); margin: .3rem 0 0; }
  .release-card .price { margin: 0 0 .8rem; font: .8rem var(--mono); }
  .release-card .price strong { font: 400 1.5rem var(--display); color: var(--gold); }
  .release-card ul { list-style: none; padding: 0; margin: 0; }
  .release-card li { display: flex; justify-content: space-between; padding: .45rem 0; border-top: 1px solid rgb(var(--bone-rgb) / .12); font-size: .75rem; color: var(--bone); }
  .live { color: var(--gold); } .live::before { content: "● " / ""; animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }

  .stats { background: var(--ink-2); color: var(--sand); padding: 40px 0; }
  .stat-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.5rem; }
  .stats .mono { color: var(--on-dark-muted); font-size: .75rem; margin: 0; }
  .stat { font-family: var(--display); font-size: clamp(1.6rem, 2.6vw, 2.4rem); line-height: 1; margin: 0 0 .5rem; color: var(--gold); white-space: nowrap; }

  .head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; }
  .head > .muted { max-width: 38ch; margin: 0; }

  /* Bento Grid Section */
  .bento-section { background: var(--bg); }
  .bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.35rem; }
  .bento-card { position: relative; background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: clamp(1.6rem, 3vw, 2.4rem); display: flex; flex-direction: column; overflow: hidden; transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s; }
  .bento-card:hover { transform: translateY(-4px); border-color: var(--clay); box-shadow: 0 18px 40px rgb(var(--ink-rgb) / .12); }
  .bento-col-2 { grid-column: span 2; }

  /* Bento Hero Card */
  .bento-hero { min-height: 400px; justify-content: flex-end; padding: clamp(2rem, 4vw, 3rem); }
  .bento-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); z-index: 0; }
  .bento-hero:hover .bento-bg-img { transform: scale(1.05); }
  .bento-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(16 40 11 / .3) 0%, rgb(16 40 11 / .88) 60%, rgb(16 40 11 / .98) 100%); z-index: 1; }
  .bento-content { position: relative; z-index: 2; color: var(--bone); display: flex; flex-direction: column; gap: .75rem; }
  .bento-badge-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: .25rem; }
  .bento-pill { display: inline-flex; align-items: center; gap: .5rem; background: var(--clay); color: var(--bone); padding: .35em .8em; border-radius: 2px; font-size: .72rem; }
  .bento-price { font-size: .85rem; color: var(--gold); }
  .bento-hero h3 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0; color: var(--bone); line-height: 1.1; }
  .bento-desc { font-size: 1rem; line-height: 1.55; color: var(--bone); opacity: .92; max-width: 58ch; margin: 0; }
  .bento-specs { display: flex; flex-wrap: wrap; gap: .6rem; font-size: .74rem; color: var(--gold); }
  .bento-action { margin-top: .5rem; }

  /* Bento Variations */
  .bento-dark { background: var(--ink) var(--topo-light); background-size: 480px; color: var(--bone); border-color: rgb(var(--bone-rgb) / .15); }
  .bento-dark:hover { border-color: var(--gold); }
  .bento-dark .bento-card-title { color: var(--bone); }
  .bento-dark .bento-sub { color: var(--on-dark-muted); }

  .bento-accent { background: #fff; border-top: 3px solid var(--clay); }
  .bento-highlight { background: var(--bone); border-top: 3px solid var(--gold); }

  .bento-top-icon { color: var(--clay); margin-bottom: 1rem; }
  .bento-kicker { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rust); margin: 0 0 .5rem; }
  .bento-stat { font-family: var(--display); font-size: clamp(2.4rem, 4vw, 3.2rem); line-height: 1; margin: 0 0 .6rem; color: var(--clay); font-weight: 400; }
  .text-gold { color: var(--gold) !important; }
  .bento-card .bento-card-title { font-family: var(--display); font-size: 1.45rem; line-height: 1.15; margin: 0 0 .6rem; color: var(--ink); }
  .bento-sub { font-size: .92rem; line-height: 1.55; color: var(--muted); margin: 0; }
  .bento-bottom-cta { margin-top: auto; padding-top: 1.5rem; }
  .bento-link { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--clay); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: .35rem; min-height: 44px; }
  .bento-link:hover { color: var(--clay-hover); text-decoration: underline; text-underline-offset: 3px; }

  .bento-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: auto; padding-top: 1.25rem; }
  .bento-tags span { font-size: .7rem; background: var(--sand-2); color: var(--ink); padding: .3em .6em; border-radius: 2px; }
  .bento-tags-dark span { background: rgb(var(--bone-rgb) / .12); color: var(--bone); }

  .plans-sec { background: var(--sand-2); }
  .plan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }

  .steps { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .steps .mono { color: var(--clay); }
  .steps h3 { margin: .6rem 0; }

  .communities { background: var(--sand-2); }
  .comm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 1.25rem; }
