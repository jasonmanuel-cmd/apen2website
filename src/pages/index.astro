---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PlanCard from '../components/PlanCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, plans, communities, offer, paths, financing, faq, photos, usd, sqftRange, areaUrl, serviceAreaNames, buyingSteps, fromShort, earlyShort, availability } from '../data/site';
import { faqPage, webPage } from '../data/schema';

// Each section uses a different photo; exteriors already appear on the model cards.
const pick = (folder: string, caption: string) => photos(folder).find((p) => p.caption === caption)!.src;
// Hero shows the Sunset Retreat model, matching the Sunset Retreat headline and card.
const hero = pick('sunset-retreat', 'Exterior');
// The release card shows the kitchen island view; the split section further down uses the other kitchen photo.
const cardKitchen = pick('sunset-retreat', 'Kitchen, alternate view');
const kitchen = pick('sunset-retreat', 'Kitchen');
const og = await getImage({ src: hero, width: 1200, format: 'jpg' });

const stats = [
  [fromShort, 'Sunset Retreat from'],
  [offer.sqft.toLocaleString('en-US'), 'Sq ft · Sunset Retreat'],
  ['6', 'Home models'],
  [offer.downPayment, 'Down option, eligible buyers'],
  [earlyShort, 'Early savings, up to'],
  [offer.moveIn, 'To move-in'],
];
const why = [
  ['Six floor plans', `${sqftRange()} sq ft, single- and two-story, each with a downloadable floor plan.`],
  ['Semi-custom finishes', 'Choose flooring, paint colors, cabinetry and more, depending on construction stage.'],
  ['Based in Tehachapi', 'A local builder serving Tehachapi and eastern Kern County.'],
  ['Buyer guides', 'Plain-English guides on buyer programs, costs and Tehachapi weather, with the sources listed.'],
];
const trust = [
  `Same owners, building in Tehachapi since ${site.since}`,
  'Local Tehachapi builder',
  'Serving Tehachapi & eastern Kern County',
  'Equal Housing Opportunity',
  ...(site.license ? [site.license] : []),
];
const steps = buyingSteps;
const title = `Tehachapi Home Builder: Sunset Retreat from ${fromShort} | ${site.name}`;
const description = `Sunset Retreat homes in Tehachapi from ${usd(offer.from)}. Six models, ${sqftRange()} sq ft. 0% down options for eligible first-time buyers. Terms apply.`;
const schema = [webPage('/', title, description, { primaryImageOfPage: { '@type': 'ImageObject', url: new URL(og.src, site.url).href } }), faqPage(faq)];
---
<Layout
  title={title}
  description={description}
  image={og.src}
  schema={schema}
>
  <section class="hero">
    <Image src={hero} alt="Sunset Retreat model exterior with the Tehachapi mountains behind it" class="hero-img" loading="eager" fetchpriority="high" widths={[800, 1280, 1600]} sizes="100vw" />
    <div class="shade"></div>
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="eyebrow reveal">Now reserving · {offer.community}, {offer.city}</p>
        <h1>{offer.community} homes in Tehachapi <em>from {usd(offer.from)}.</em></h1>
        <p class="lede">Reserve a home at {offer.community}, or choose one of six semi-custom models in Tehachapi and eastern Kern County.</p>
        <p class="asof mono reveal" style="animation-delay:.25s">Pricing and availability change. Contact us to confirm what is available today. <a href="/available-homes/#availability">Current release details <span aria-hidden="true">→</span></a></p>
        <div class="ctas reveal" style="animation-delay:.3s">
          <a class="btn" href="/available-homes/">See Sunset Retreat availability</a>
          <a class="btn btn-ghost" href="/floor-plans/">Compare floor plans</a>
        </div>
      </div>
      <a class="release-card reveal" style="animation-delay:.4s" href="/available-homes/" aria-label={`First release, ${availability.releaseCount.toLowerCase()} homes: ${offer.community}, from ${usd(offer.from)}`}>
        <Image src={cardKitchen} alt="Kitchen with island in the Sunset Retreat model" widths={[400, 700]} sizes="360px" />
        <div>
          <p class="mono k">First release · {availability.releaseCount.toLowerCase()} {availability.releaseCount === 'One' ? 'home' : 'homes'}</p>
          <p class="name">{offer.community}</p>
          <p class="price">From <strong>{usd(offer.from)}</strong></p>
          <ul>{offer.release.map(([h, s]) => <li class="mono"><span>{h}</span><span class:list={[{ live: s === 'Reserving' }]}>{s}</span></li>)}</ul>
        </div>
      </a>
    </div>
  </section>

  <section class="trust" aria-label="About Aspen II Homes">
    <ul class="wrap">{trust.map((t) => <li class="mono">{t}</li>)}</ul>
  </section>

  <section class="stats" aria-label="At a glance">
    <div class="wrap stat-grid">{stats.map(([n, l]) => <div><p class="stat">{n}</p><p class="mono">{l}</p></div>)}</div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Two ways to own</p>
          <h2>Reserve a home or <em>make a model yours.</em></h2>
        </div>
        <p class="muted">Sunset Retreat first-release homes are estimated at roughly three months to move-in, subject to construction conditions. Sending a question commits you to nothing, so ask away.</p>
      </div>
      <div class="paths">
        {paths.map((p, i) => (
          <article class:list={['path', { featured: i === 0 }]}>
            {p.badge && <span class="badge mono">{p.badge}</span>}
            <p class="mono n">Path {p.n} · {p.name}</p>
            <h3>{p.title}</h3>
            <p class="mono meta">{p.meta}</p>
            <p>{p.text}</p>
            <p class="p-price">{p.price}</p>
            <a class="btn" href={p.cta[1]}>{p.cta[0]}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section plans-sec" id="plans">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">The model collection</p>
          <h2>Six models. <em>Your finishes.</em></h2>
        </div>
        <p class="muted">Browse photos and renderings where we have them, plus the blueprint for every home, then pick the one that fits your life.</p>
      </div>
      <div class="plan-grid">{plans.map((plan) => <PlanCard plan={plan} />)}</div>
      <p class="compare-link"><a class="btn btn-ghost" href="/floor-plans/#compare"><span aria-hidden="true">⇄</span> Compare all six models side by side</a></p>
    </div>
  </section>

  <section class="split">
    <Image src={kitchen} alt="Kitchen in the Sunset Retreat model" widths={[600, 1000, 1536]} sizes="(max-width: 1000px) 100vw, 50vw" />
    <div class="split-copy">
      <p class="eyebrow">Your finishes</p>
      <h2>Your model. <em>Finished to your taste.</em></h2>
      <p>You don’t just buy a house, you help shape it. Choose your model, select your finishes and move into a home that’s truly yours from day one.</p>
      <div class="why">{why.map(([t, d]) => <div><h3>{t}</h3><p class="muted">{d}</p></div>)}</div>
    </div>
  </section>

  <section class="section incentives">
    <div class="wrap inc-grid">
      <div>
        <p class="eyebrow">Buyer incentives</p>
        <h2>Owning is closer <em>than you think.</em></h2>
        <p>First-time buyer programs, an early-buyer credit you can put toward your floor plan, and buyer-friendly terms. We’ll help you find the path that makes owning work.</p>
        <ul class="programs">{financing.programs.map((p) => <li class="mono">{p}</li>)}</ul>
        <div class="ctas"><a class="btn" href="/financing/">See how it works</a><a class="btn btn-ghost" href={site.sms('FINANCING')}>Text FINANCING</a></div>
      </div>
      <div class="big-nums">
        <div><p class="n">0%</p><p class="mono">Down option for eligible first-time buyers</p></div>
        <div><p class="n"><span class="up">Up to</span> {usd(offer.earlyCredit)}</p><p class="mono">Early-buyer savings toward your plan</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Simple steps</p>
      <h2>How it <em>works.</em></h2>
      <ol class="steps">{steps.map(([t, d], i) => <li><span class="mono">Step 0{i + 1}</span><h3>{t}</h3><p class="muted">{d}</p></li>)}</ol>
    </div>
  </section>

  <section class="section communities" id="communities">
    <div class="wrap">
      <div class="head">
        <div>
          <p class="eyebrow">Where we build</p>
          <h2>Based in Tehachapi. <em>Serving the region.</em></h2>
        </div>
        <p class="muted">{site.name} is a local new home builder based in Tehachapi. The same owners have been building homes there since {site.since}, first as {site.originalEntity} and, since {site.incorporated}, as {site.currentEntity}{site.license && ` (${site.license})`}. We know the building regulations, suppliers and subcontractors in the areas we serve.</p>
      </div>
      <div class="comm-grid">
        {communities.filter((c) => c.published).map((c) => <a href={areaUrl(c)} class="comm"><h3>{c.name}</h3><p class="muted">{c.short}</p><span class="mono">Explore <span aria-hidden="true">→</span></span></a>)}
        <a href="/areas/" class="comm"><h3>Nearby communities</h3><p class="muted">{serviceAreaNames.filter((n) => n !== 'Tehachapi').join(', ')}. Availability confirmed case by case.</p><span class="mono">Areas we serve <span aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Your questions</p>
        <h2>Planning your <em>new home.</em></h2>
        <p class="muted">Still curious? Call <a href={site.phoneHref}>{site.phone}</a> or text HOMES for instant answers.</p>
      </div>
      <div class="faq">
        {faq.map(([q, a, href], i) => <details open={i === 0}><summary>{q}</summary><p>{a} <a href={href} class="more" aria-label={`Full answer: ${q}`}>Full answer <span aria-hidden="true">→</span></a></p></details>)}
      </div>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Talk to our team</p>
        <h2>Your brand-new home starts with <em>a conversation.</em></h2>
        <p class="muted">Reserve a {offer.community} home, or choose a semi-custom model. No pressure, just answers.</p>
        <p class="direct mono"><a href={site.phoneHref}>{site.phone}</a><br /><a href={site.sms()}>Text HOMES</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <LeadForm source="Home page" compact />
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; min-height: min(90vh, 880px); min-height: min(90svh, 880px); display: flex; align-items: flex-end; color: var(--bone); overflow: hidden; }
  .hero :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: zoom 20s var(--ease) both; }
  @keyframes zoom { from { transform: scale(1.1); } }
  .shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(0 0 0 / .66), rgb(0 0 0 / .08) 70%), linear-gradient(180deg, transparent 45%, rgb(0 0 0 / .7)); }
  .hero-grid { position: relative; width: 100%; display: grid; grid-template-columns: 1.5fr minmax(280px, 360px); gap: 3rem; align-items: end; padding-bottom: clamp(40px, 8vh, 90px); padding-top: 6rem; }
  .hero .eyebrow { color: var(--bone); }
  .hero em { color: var(--bone); }
  .hero h1 { max-width: 15ch; font-size: clamp(2.6rem, 6.4vw, 5.6rem); }
  .asof { font-size: .75rem; opacity: .85; margin: .5rem 0 0; } .asof a { color: var(--bone); text-decoration: underline; text-underline-offset: 3px; }
  .trust { background: var(--paper); border-bottom: 1px solid var(--line); }
  .trust ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 2rem; padding-top: 1rem; padding-bottom: 1rem; margin: 0 auto; }
  .trust li { font-size: .75rem; color: var(--ink); }
  .trust li::before { content: "✓ " / ""; color: var(--clay); }
  .compare-link { margin-top: 2.5rem; }
  .faq .more { color: var(--clay); white-space: nowrap; }
  .hero h1 em { display: block; }
  .lede { max-width: 50ch; font-size: 1.15rem; opacity: .92; }
  .ctas { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .release-card { display: block; background: rgb(var(--ink-rgb) / .96); border: 1px solid rgb(var(--bone-rgb) / .12); border-top: 3px solid var(--gold); box-shadow: 0 24px 60px rgb(0 0 0 / .3); text-decoration: none; transition: transform .35s var(--ease); }
  .release-card:hover { transform: translateY(-4px); }
  .release-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .release-card > div { padding: 1.2rem 1.4rem 1.4rem; }
  .release-card .k { color: var(--gold); font-size: .75rem; margin: 0; }
  .release-card .name { font: 1.7rem var(--display); margin: .3rem 0 0; }
  .release-card .price { margin: 0 0 .8rem; font: .8rem var(--mono); }
  .release-card .price strong { font: 400 1.5rem var(--display); color: var(--gold); }
  .release-card ul { list-style: none; padding: 0; margin: 0; }
  .release-card li { display: flex; justify-content: space-between; padding: .45rem 0; border-top: 1px solid rgb(var(--bone-rgb) / .12); font-size: .75rem; color: var(--bone); }
  .live { color: var(--gold); } .live::before { content: "● " / ""; animation: pulse 1.6s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .release-card { max-width: 420px; } }

  .stats { background: var(--ink-2); color: var(--sand); padding: 40px 0; }
  .stat-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.5rem; }
  .stats .mono { color: var(--on-dark-muted); font-size: .75rem; margin: 0; }
  .stat { font-family: var(--display); font-size: clamp(1.6rem, 2.6vw, 2.4rem); line-height: 1; margin: 0 0 .5rem; color: var(--gold); white-space: nowrap; }
  @media (max-width: 900px) { .stat-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .stat-grid { grid-template-columns: 1fr 1fr; } }

  .head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; }
  .head > .muted { max-width: 38ch; margin: 0; }
  @media (max-width: 760px) { .head { flex-direction: column; align-items: start; } }

  .paths { display: grid; grid-template-columns: repeat(2, 1fr); max-width: 900px; gap: 1.25rem; }
  .path { position: relative; display: flex; flex-direction: column; padding: 2rem; border: 1px solid var(--line); background: var(--paper); box-shadow: 0 10px 30px rgb(var(--ink-rgb) / .07); }
  .path.featured { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .path .n { color: var(--clay); font-size: .75rem; margin: 0 0 1.5rem; }
  .path.featured .n { color: var(--gold); }
  .path .meta { font-size: .75rem; color: var(--muted); margin: -.2rem 0 1rem; }
  .path.featured .meta { color: var(--on-dark-muted); }
  .p-price { font: 1.6rem var(--display); margin: auto 0 1.2rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .path.featured .p-price { color: var(--gold); border-color: rgb(var(--bone-rgb) / .15); }
  .path .btn { align-self: start; }
  .path:not(.featured) .btn { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .path:not(.featured) .btn:hover { background: var(--ink); color: var(--bone); }
  .badge { position: absolute; top: -10px; right: 1.5rem; background: var(--gold); color: var(--ink); font-size: .75rem; padding: .35em .8em; }
  @media (max-width: 900px) { .paths { grid-template-columns: 1fr; } }

  .plans-sec { background: var(--sand-2); }
  .plan-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: 1.25rem; }

  .split { display: grid; grid-template-columns: 1fr 1fr; background: var(--sand); }
  .split img { width: 100%; height: 100%; object-fit: cover; min-height: 420px; }
  .split-copy { padding: clamp(40px, 6vw, 88px); align-self: center; }
  .why { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; margin-top: 2rem; }
  .why h3 { font-size: 1.2rem; margin-bottom: .3rem; }
  .why p { margin: 0; font-size: .98rem; }
  @media (max-width: 1000px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .why { grid-template-columns: 1fr; } }

  .incentives { background: var(--ink) var(--topo-light); background-size: 480px; color: var(--bone); }
  .incentives em, .incentives .eyebrow { color: var(--gold); }
  .inc-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .programs { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .programs li { border: 1px solid rgb(var(--bone-rgb) / .25); padding: .45em .9em; font-size: .75rem; }
  .big-nums > div { border-top: 1px solid rgb(var(--bone-rgb) / .15); padding: 1.3rem 0; }
  .big-nums .n { font: clamp(2.6rem, 6vw, 4.4rem)/1 var(--display); color: var(--gold); margin: 0 0 .4rem; }
  .big-nums .up { display: block; font: .75rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--on-dark-muted); margin-bottom: .3rem; }
  .big-nums .mono { margin: 0; color: var(--on-dark-muted); font-size: .75rem; }
  @media (max-width: 860px) { .inc-grid { grid-template-columns: 1fr; } }

  .steps { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .steps .mono { color: var(--clay); }
  .steps h3 { margin: .6rem 0; }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }

  .communities { background: var(--sand-2); }
  .comm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 1.25rem; }
  .comm { display: flex; flex-direction: column; padding: 1.8rem; background: var(--paper); border: 1px solid var(--line); text-decoration: none; transition: border-color .3s, transform .3s var(--ease); }
  .comm:hover { border-color: var(--clay); transform: translateY(-4px); }
  .comm h3 { font-size: 1.35rem; }
  .comm .mono { margin-top: auto; color: var(--clay); font-size: .75rem; }


  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq-grid .muted a { color: var(--clay); }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; padding: 1.2rem 2.5rem 1.2rem 0; position: relative; font: 1.2rem var(--display); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+" / ""; position: absolute; right: .3rem; top: 1rem; font: 1.5rem var(--mono); color: var(--clay); transition: transform .3s var(--ease); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { margin: 0 0 1.4rem; color: var(--muted); max-width: 60ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

  .contact { background: var(--sand-2); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .direct { margin-top: 2rem; line-height: 2.2; }
  .direct a { text-decoration: none; color: var(--clay); }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
