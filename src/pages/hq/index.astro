---
// Aspen II Homes HQ: lead inbox and site analytics in one place.
// Standalone on purpose: no site layout, so no Google Analytics, no site chrome,
// no search indexing. Not linked anywhere. Needs the STAFF_TOKEN password, the
// same one the /staff/ inbox uses.
import '@fontsource/gloock/latin-400.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HQ | Aspen II Homes</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />
  <link rel="icon" href="/favicon.png" />
</head>
<body>
  <main id="app">
    <header class="top">
      <h1>HQ</h1>
      <p class="mono who">Aspen II Homes · staff only</p>
    </header>

    <section id="login" aria-labelledby="login-h">
      <h2 id="login-h">Sign in</h2>
      <form id="login-form">
        <label>Password
          <input id="token" type="password" autocomplete="current-password" required />
        </label>
        <button class="btn" type="submit">Open HQ</button>
        <p id="login-msg" class="msg" role="alert"></p>
      </form>
    </section>

    <section id="panel" hidden>
      <div class="tabs" role="tablist" aria-label="HQ sections">
        <button role="tab" id="tab-leads" aria-controls="view-leads" aria-selected="true" tabindex="0">Leads</button>
        <button role="tab" id="tab-analytics" aria-controls="view-analytics" aria-selected="false" tabindex="-1">Traffic</button>
        <button role="tab" id="tab-chats" aria-controls="view-chats" aria-selected="false" tabindex="-1">Chats <span id="badge-chats" class="badge" hidden></span></button>
        <button role="tab" id="tab-calls" aria-controls="view-calls" aria-selected="false" tabindex="-1">Callbacks <span id="badge-calls" class="badge" hidden></span></button>
        <button role="tab" id="tab-appts" aria-controls="view-appts" aria-selected="false" tabindex="-1">Appointments <span id="badge-appts" class="badge" hidden></span></button>
      </div>
      <div class="bar">
        <p id="counts" class="mono" role="status" aria-live="polite"></p>
        <div class="bar-btns">
          <button class="btn ghost" id="refresh" type="button">Refresh</button>
          <button class="btn ghost" id="logout" type="button">Sign out</button>
        </div>
      </div>

      <!-- Leads -->
      <div id="view-leads" role="tabpanel" aria-labelledby="tab-leads">
        <div class="filters" role="group" aria-label="Filter by status" id="status-filters"></div>
        <div class="search-row">
          <label class="grow">Search name, email or phone
            <input id="q" type="search" autocomplete="off" spellcheck="false" />
          </label>
          <label class="check"><input id="unsent" type="checkbox" /> Email not sent</label>
        </div>
        <p id="list-msg" class="msg" role="status" aria-live="polite"></p>
        <ul id="list" role="list"></ul>
        <button class="btn ghost" id="more" type="button" hidden>Load more</button>
      </div>

      <!-- Traffic -->
      <div id="view-analytics" role="tabpanel" aria-labelledby="tab-analytics" hidden>
        <div class="range" role="group" aria-label="Date range" id="range"></div>
        <p id="an-msg" class="msg" role="status" aria-live="polite"></p>
        <div id="an-body"></div>
      </div>

      <!-- Chats -->
      <div id="view-chats" role="tabpanel" aria-labelledby="tab-chats" hidden>
        <div class="range" role="group" aria-label="Filter chats" id="chat-filters"></div>
        <p id="chat-msg" class="msg" role="status" aria-live="polite"></p>
        <ul id="chat-list" role="list" class="plain"></ul>
      </div>

      <!-- Callbacks -->
      <div id="view-calls" role="tabpanel" aria-labelledby="tab-calls" hidden>
        <div class="range" role="group" aria-label="Filter callbacks" id="call-filters"></div>
        <p id="call-msg" class="msg" role="status" aria-live="polite"></p>
        <ul id="call-list" role="list" class="plain"></ul>
      </div>

      <!-- Appointments -->
      <div id="view-appts" role="tabpanel" aria-labelledby="tab-appts" hidden>
        <div class="range" role="group" aria-label="Filter appointments" id="appt-filters"></div>
        <p id="appt-msg" class="msg" role="status" aria-live="polite"></p>
        <ul id="appt-list" role="list" class="plain"></ul>
      </div>
    </section>
  </main>

  <script>
    // @ts-nocheck
    // Every value from the database is written with textContent, never as HTML, so a lead can't inject markup here.
    const STATUSES = ['new', 'contacted', 'qualified', 'nurturing', 'won', 'lost', 'spam', 'test'];
    const LABEL = { new: 'New', contacted: 'Contacted', qualified: 'Qualified', nurturing: 'Nurturing', won: 'Won', lost: 'Lost', spam: 'Spam', test: 'Test', all: 'All' };
    const KEY = 'aspen_staff_inbox';
    const RANGES = [[7, '7 days'], [30, '30 days'], [90, '90 days']];
    const $ = (id) => document.getElementById(id);
    const state = { status: 'new', unsent: false, q: '', offset: 0, leads: [], total: 0, limit: 50, days: 30 };
    let token = '';
    try { token = sessionStorage.getItem(KEY) || ''; } catch {}

    const el = (tag, props = {}, ...kids) => {
      const n = document.createElement(tag);
      for (const [k, v] of Object.entries(props)) {
        if (v == null || v === false) continue;
        if (k === 'class') n.className = v;
        else if (k === 'text') n.textContent = v;
        else if (k === 'on') for (const [ev, fn] of Object.entries(v)) n.addEventListener(ev, fn);
        else n.setAttribute(k, v === true ? '' : v);
      }
      // `cond && el(...)` yields false when cond is false; append(false) would print the word "false".
      for (const kid of kids.flat()) if (kid != null && kid !== false) n.append(kid);
      return n;
    };

    const when = (iso) => iso ? new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const day = (iso) => iso ? new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }) : '';
    const dateValue = (iso) => (iso ? String(iso).slice(0, 10) : '');
    const phoneDigits = (p) => String(p || '').replace(/[^\d+]/g, '');
    const EMAIL = /^[^\s@<>"']+@[^\s@<>"']+\.[^\s@<>"']+$/;
    const shortDate = (d) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
    const fmtDuration = (s) => !s ? '0s' : s < 60 ? `${s}s` : s < 3600 ? `${Math.floor(s / 60)}m` : `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;

    class AuthError extends Error {}
    const api = async (path, init = {}) => {
      const res = await fetch(`/api/staff/leads${path}`, {
        ...init,
        headers: { Authorization: `Bearer ${token}`, ...(init.body ? { 'Content-Type': 'application/json' } : {}) }
      });
      let data = null;
      try { data = await res.json(); } catch {}
      if (res.status === 401) throw new AuthError(data?.error || 'Wrong password.');
      if (!res.ok || !data?.ok) throw new Error(data?.error || 'Something went wrong. Try again.');
      return data;
    };
    const analytics = async () => {
      const res = await fetch(`/api/hq/analytics?days=${state.days}`, { headers: { Authorization: `Bearer ${token}` } });
      let data = null;
      try { data = await res.json(); } catch {}
      if (res.status === 401) throw new AuthError(data?.error || 'Wrong password.');
      if (!res.ok || !data?.ok) throw new Error(data?.error || 'Could not load traffic.');
      return data;
    };

    const show = (signedIn) => { $('login').hidden = signedIn; $('panel').hidden = !signedIn; };
    const signOut = (msg = '') => {
      token = '';
      try { sessionStorage.removeItem(KEY); } catch {}
      state.leads = []; $('list').replaceChildren(); $('an-body').replaceChildren(); $('chat-list').replaceChildren(); $('appt-list').replaceChildren(); $('call-list').replaceChildren(); setBadge('badge-chats', 0); setBadge('badge-appts', 0); setBadge('badge-calls', 0); $('token').value = '';
      $('login-msg').textContent = msg;
      show(false);
      if (msg) $('token').focus();
    };

    // ---------------------------------------------------------------- leads

    const buildFilters = () => {
      $('status-filters').replaceChildren(...['new', 'contacted', 'qualified', 'nurturing', 'won', 'lost', 'spam', 'test', 'all'].map((s) =>
        el('button', { type: 'button', class: 'chip', 'aria-pressed': String(state.status === s), text: LABEL[s], on: { click: () => { state.status = s; buildFilters(); loadLeads(); } } })));
    };

    const field = (label, value) => value ? el('div', {}, el('dt', { class: 'mono', text: label }), el('dd', { text: value })) : null;

    const buildItem = (lead, open) => {
      const unsent = !lead.email_sent;
      const summary = el('summary', {},
        el('span', { class: 'row-main' },
          el('strong', { text: lead.name }),
          el('span', { class: 'mono sub', text: [when(lead.created_at), lead.plan || lead.community || lead.interest, lead.source].filter(Boolean).join(' · ') })),
        el('span', { class: 'badges' },
          el('span', { class: `badge s-${lead.status}`, text: LABEL[lead.status] || lead.status }),
          unsent && el('span', { class: 'badge warn', text: 'Email not sent' }),
          lead.follow_up_at && el('span', { class: 'badge', text: `Follow up ${day(lead.follow_up_at)}` })));

      const email = lead.email && EMAIL.test(lead.email) ? lead.email : '';
      const actions = el('p', { class: 'actions' },
        el('a', { class: 'btn', href: `tel:${phoneDigits(lead.phone)}`, text: `Call ${lead.phone}` }),
        el('a', { class: 'btn ghost', href: `sms:${phoneDigits(lead.phone)}`, text: 'Text' }),
        email && el('a', { class: 'btn ghost', href: `mailto:${email}`, text: 'Email' }));

      const details = el('dl', { class: 'details' },
        field('Phone', lead.phone), field('Email', lead.email), field('Interested in', lead.interest), field('Model', lead.plan),
        field('Community', lead.community), field('Best way to reach', lead.contact_pref), field('Stage', lead.stage),
        field('Timeline', lead.buy_window), field('Budget', lead.budget),
        field('Asked about', [lead.first_time && 'First-time buyer options', lead.military && 'VA / military options'].filter(Boolean).join(', ')),
        field('Source', [lead.source, lead.origin_domain].filter(Boolean).join(' · ')),
        field('Contacted', when(lead.contacted_at)),
        unsent && lead.email_error ? field('Email problem', lead.email_error) : null,
        lead.notes ? el('div', { class: 'wide' }, el('dt', { class: 'mono', text: 'What they wrote' }), el('dd', { class: 'notes', text: lead.notes })) : null);

      const status = el('p', { class: 'msg', role: 'status', 'aria-live': 'polite' });
      const sel = el('select', { name: 'status' }, STATUSES.map((s) => el('option', { value: s, text: LABEL[s], selected: s === lead.status })));
      const who = el('input', { name: 'assigned_to', maxlength: '60', autocomplete: 'off', value: lead.assigned_to || '' });
      const fu = el('input', { name: 'follow_up_at', type: 'date', value: dateValue(lead.follow_up_at) });
      const notes = el('textarea', { name: 'staff_notes', rows: '4', maxlength: '3000' });
      notes.value = lead.staff_notes || '';
      const save = el('button', { class: 'btn', type: 'submit', text: 'Save changes' });
      const form = el('form', { class: 'edit', on: { submit: async (e) => {
        e.preventDefault();
        save.disabled = true; status.textContent = 'Saving…';
        try {
          const data = await api(`?id=${encodeURIComponent(lead.id)}`, { method: 'PATCH', body: JSON.stringify({
            status: sel.value, assigned_to: who.value, follow_up_at: fu.value || null, staff_notes: notes.value }) });
          const i = state.leads.findIndex((l) => l.id === lead.id);
          if (i >= 0) state.leads[i] = data.lead;
          const fresh = buildItem(data.lead, true);
          li.replaceWith(fresh);
          fresh.querySelector('.edit .msg').textContent = 'Saved.';
        } catch (err) {
          if (err instanceof AuthError) return signOut('Your session ended. Sign in again.');
          status.textContent = err.message; save.disabled = false;
        }
      } } },
        el('label', {}, 'Status', sel),
        el('label', {}, 'Assigned to', who),
        el('label', {}, 'Follow up on', fu),
        el('label', { class: 'wide' }, 'Team notes', notes),
        el('div', { class: 'wide' }, save, status));

      const li = el('li', { class: 'lead' }, el('details', { open }, summary, actions, details, form));
      return li;
    };

    const renderList = () => {
      $('list').replaceChildren(...state.leads.map((l) => buildItem(l, false)));
      $('more').hidden = state.leads.length >= state.total;
      $('list-msg').textContent = state.leads.length ? '' : 'No leads match.';
    };

    const counts = (d) => {
      const parts = [];
      if (d.newCount != null) parts.push(`${d.newCount} new`);
      if (d.unsentCount) parts.push(`${d.unsentCount} email not sent`);
      parts.push(d.total != null ? `showing ${state.leads.length} of ${d.total}` : `showing ${state.leads.length}`);
      $('counts').textContent = parts.join(' · ');
    };

    const query = () => {
      const p = new URLSearchParams({ status: state.status, limit: String(state.limit), offset: String(state.offset) });
      if (state.unsent) p.set('unsent', '1');
      if (state.q) p.set('q', state.q);
      return `?${p}`;
    };

    let seq = 0;
    const loadLeads = async (append = false, fromLogin = false) => {
      const mine = ++seq;
      if (!append) state.offset = 0;
      $('list-msg').textContent = 'Loading…';
      try {
        const d = await api(query());
        if (mine !== seq) return;
        state.total = d.total ?? d.leads.length;
        state.leads = append ? state.leads.concat(d.leads) : d.leads;
        renderList(); counts(d);
        show(true);
      } catch (err) {
        if (mine !== seq) return;
        if (err instanceof AuthError) { if (!fromLogin) signOut('Your session ended. Sign in again.'); throw err; }
        $('list-msg').textContent = err.message;
        throw err;
      }
    };

    // ------------------------------------------------------------- analytics

    const card = (title, hint, ...kids) =>
      el('section', { class: 'card' }, el('h3', { text: title }), hint && el('p', { class: 'mono hint', text: hint }), ...kids);

    const stat = (label, value, sub) => el('div', { class: 'stat' },
      el('p', { class: 'mono k', text: label }), el('p', { class: 'v', text: value }), sub && el('p', { class: 'mono s', text: sub }));

    // Horizontal bars. Widths come from the data and are set as percentages, so
    // nothing here can inject markup.
    const bars = (items, label = (k) => k) => {
      if (!items.length) return el('p', { class: 'muted small', text: 'No data yet.' });
      const max = Math.max(...items.map((i) => i.value)) || 1;
      return el('ul', { class: 'bars' }, ...items.map((i) => el('li', {},
        el('span', { class: 'bl', text: label(i.key) }),
        el('span', { class: 'bt' }, el('span', { class: 'bf', style: `width:${Math.max((i.value / max) * 100, 1)}%` })),
        el('span', { class: 'bv', text: String(i.value) }))));
    };

    const chart = (daily) => {
      if (!daily.length) return el('p', { class: 'muted small', text: 'No data yet.' });
      // Each column stacks page views above sessions, so the tallest column is the largest page-view total.
      const max = Math.max(...daily.map((d) => Math.max(d.pageViews, d.sessions)), 1);
      const pct = (n) => `height:${(n / max) * 100}%`;
      return el('div', { class: 'chart', role: 'img', 'aria-label': `Sessions per day over ${daily.length} days` },
        ...daily.map((d, i) => el('div', { class: 'col', title: `${shortDate(d.day)}: ${d.sessions} sessions, ${d.pageViews} page views` },
          el('span', { class: 'plot' },
            d.pageViews > d.sessions ? el('span', { class: 'stack pv', style: pct(d.pageViews - d.sessions) }) : null,
            el('span', { class: 'stack', style: pct(d.sessions) })),
          // Thirty crowded labels are unreadable; label the first column and roughly every sixth, the tooltip has the rest.
          el('span', { class: i >= daily.length * 0.8 ? 'lbl end' : 'lbl', 'aria-hidden': 'true', text: i % Math.ceil(daily.length / 6) === 0 ? shortDate(d.day) : '' }))));
    };

    const renderAnalytics = (d) => {
      const t = d.totals;
      const pageLabel = (p) => p.replace(/\/$/, '') || '/';
      const hourlyMax = Math.max(...d.hourlyUtc.map((h) => h.value), 1);

      $('an-body').replaceChildren(
        el('div', { class: 'stats' },
          stat('Sessions', String(t.sessions)),
          stat('Unique visitors', String(t.uniqueVisitors), 'daily hash'),
          stat('Page views', String(t.pageViews)),
          stat('Pages / session', String(t.pagesPerSession)),
          stat('Avg engaged', fmtDuration(t.avgDurationSeconds), 'median ' + fmtDuration(t.medianDurationSeconds)),
          stat('Leads', t.leadsInWindow == null ? '—' : String(t.leadsInWindow), `last ${d.days} days`)),

        card('Sessions and page views', `Last ${d.days} days, by day`, chart(d.daily)),

        el('div', { class: 'two' },
          card('Where visits came from', 'Referrer type', bars(d.referrers, (k) => k === 'unknown' ? 'Unknown' : k[0].toUpperCase() + k.slice(1))),
          card('Top referring sites', 'Host only — full URLs are never stored', bars(d.referrerHosts, (k) => k === 'unknown' ? 'Direct / unknown' : k))),

        el('div', { class: 'two' },
          card('Top pages', 'Most viewed, with total engaged time', bars(d.topPages, (k) => `${pageLabel(k)} · ${fmtDuration(d.topPages.find((p) => p.key === k)?.duration ?? 0)}`)),
          card('Entry pages', 'Where sessions began', bars(d.entryPages, pageLabel))),

        el('div', { class: 'two' },
          card('Devices', null, bars(d.devices)),
          card('Browsers', null, bars(d.browsers))),

        el('div', { class: 'two' },
          card('Operating systems', null, bars(d.operatingSystems)),
          card('Busiest hours', 'UTC — visitors’ local time is not collected', el('div', { class: 'hours' },
            ...d.hourlyUtc.map((h) => el('span', { class: 'hr', title: `${String(h.hour).padStart(2, '0')}:00 UTC: ${h.value} sessions`,
              style: `height:${Math.max((h.value / hourlyMax) * 100, 2)}%` }))))),

        el('div', { class: 'two' },
          card('Countries', 'From the edge. No IP is stored, so this cannot be more precise than the region.',
            bars(d.countries, (k) => k === 'unknown' ? 'Unknown' : k)),
          card('States and regions', null, bars(d.regions, (k) => k === 'unknown' ? 'Unknown' : k))),

        el('div', { class: 'two' },
          card('Cities', null, bars(d.cities, (k) => k === 'unknown' ? 'Unknown' : k)),
          card('Campaigns', 'From UTM parameters', bars(d.campaigns.length ? d.campaigns : d.sources, (k) => k === 'unknown' ? 'No campaign tag' : k))),

        el('p', { class: 'mono footnote', text: 'No IP addresses are stored. Unique visitors are counted with a salted hash that changes every day, so no one can be tracked across visits. Bots are excluded from every figure above.' })
      );
    };

    let anSeq = 0;
    const loadAnalytics = async () => {
      const mine = ++anSeq;
      $('an-msg').textContent = 'Loading…';
      $('an-body').replaceChildren();
      try {
        const d = await analytics();
        if (mine !== anSeq) return;
        renderAnalytics(d);
        $('an-msg').textContent = '';
      } catch (err) {
        if (mine !== anSeq) return;
        if (err instanceof AuthError) return signOut('Your session ended. Sign in again.');
        $('an-msg').textContent = err.message;
      }
    };

    const buildRanges = () => {
      $('range').replaceChildren(...RANGES.map(([d, l]) =>
        el('button', { type: 'button', class: 'chip', 'aria-pressed': String(state.days === d), text: l,
          on: { click: () => { state.days = d; buildRanges(); loadAnalytics(); } } })));
    };

    // ------------------------------------------------------- chats + appointments

    const hq = async (path, init = {}) => {
      const res = await fetch(`/api/hq/chat${path}`, {
        ...init,
        headers: { Authorization: `Bearer ${token}`, ...(init.body ? { 'Content-Type': 'application/json' } : {}) }
      });
      let data = null;
      try { data = await res.json(); } catch {}
      if (res.status === 401) throw new AuthError(data?.error || 'Wrong password.');
      if (!res.ok || !data?.ok) throw new Error(data?.error || 'Something went wrong. Try again.');
      return data;
    };
    const setBadge = (id, n) => { const b = $(id); b.textContent = n ? String(n) : ''; b.hidden = !n; };
    const chatState = { filter: 'all', appt: 'open', call: 'open' };
    const CALL_LABEL = { requested: 'Call back', called: 'Called', no_answer: 'No answer', closed: 'Closed' };
    const APPT_LABEL = { requested: 'Requested', confirmed: 'Confirmed', completed: 'Completed', cancelled: 'Cancelled', no_show: 'No-show' };
    const clock = (t) => { const [h, m] = String(t).split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; };

    const renderMessages = (box, messages) => {
      box.replaceChildren(...messages.map((m) => el('p', { class: `bubble ${m.role}`, text: `${m.role === 'user' ? 'Visitor' : 'Assistant'}: ${m.content}` })));
    };

    const chatItem = (c) => {
      const who = c.lead ? `${c.lead.name} · ${c.lead.phone}` : 'No contact details';
      const body = el('div', { class: 'thread' });
      const resolve = el('button', { type: 'button', class: 'chip', text: c.resolved ? 'Reopen' : 'Mark handled',
        on: { click: async () => {
          try { await hq(`?view=conversations&id=${encodeURIComponent(c.id)}`, { method: 'PATCH', body: JSON.stringify({ resolved: !c.resolved }) }); loadChats(); }
          catch (err) { if (err instanceof AuthError) signOut('Your session ended. Sign in again.'); else $('chat-msg').textContent = err.message; }
        } } });
      const details = el('details', {},
        el('summary', {},
          el('strong', { text: who }),
          c.needs_human && !c.resolved ? el('span', { class: 'flag', text: ' Needs a person' }) : null,
          el('span', { class: 'mono hint', text: ` ${c.channel === 'sms' ? 'Text · ' : ''}${c.message_count} messages · ${when(c.last_message_at)}` })),
        c.handoff_reason ? el('p', { class: 'mono hint', text: `Reason: ${c.handoff_reason}` }) : null,
        c.lead?.email ? el('p', { class: 'mono hint', text: c.lead.email }) : null,
        body, resolve);
      details.addEventListener('toggle', async () => {
        if (!details.open || body.childElementCount) return;
        body.textContent = 'Loading…';
        try { const d = await hq(`?view=messages&id=${encodeURIComponent(c.id)}`); renderMessages(body, d.messages); }
        catch (err) { body.textContent = err instanceof AuthError ? 'Session ended.' : err.message; }
      });
      return el('li', { class: 'card' }, details);
    };

    let chatSeq = 0;
    const loadChats = async () => {
      const mine = ++chatSeq;
      $('chat-msg').textContent = 'Loading…';
      try {
        const d = await hq(`?view=conversations&filter=${chatState.filter}`);
        if (mine !== chatSeq) return;
        setBadge('badge-chats', d.needHuman); setBadge('badge-appts', d.openAppointments); setBadge('badge-calls', d.openCallbacks);
        $('chat-list').replaceChildren(...d.conversations.map(chatItem));
        $('chat-msg').textContent = d.conversations.length ? '' : (chatState.filter === 'human' ? 'No chats need a person.' : 'No chats yet.');
      } catch (err) {
        if (mine !== chatSeq) return;
        if (err instanceof AuthError) return signOut('Your session ended. Sign in again.');
        $('chat-msg').textContent = err.message;
      }
    };

    const apptItem = (a) => {
      const set = async (status) => {
        try { await hq(`?view=appointments&id=${encodeURIComponent(a.id)}`, { method: 'PATCH', body: JSON.stringify({ status }) }); loadAppts(); }
        catch (err) { if (err instanceof AuthError) signOut('Your session ended. Sign in again.'); else $('appt-msg').textContent = err.message; }
      };
      const next = a.status === 'requested' ? [['confirmed', 'Confirm']] : a.status === 'confirmed' ? [['completed', 'Completed'], ['no_show', 'No-show']] : [];
      const actions = [...next, ...(a.status === 'requested' || a.status === 'confirmed' ? [['cancelled', 'Cancel']] : [])];
      return el('li', { class: 'card' },
        el('h3', { text: `${a.kind === 'tour' ? 'Tour' : 'Call'}: ${a.name}` }),
        el('p', { class: 'mono', text: `${shortDate(a.preferred_date)} at ${clock(a.preferred_time)} (Tehachapi time) · ${APPT_LABEL[a.status] || a.status}` }),
        el('p', { class: 'mono hint' }, el('a', { href: `tel:${phoneDigits(a.phone)}`, text: a.phone }), a.email && EMAIL.test(a.email) ? ` · ${a.email}` : ''),
        a.notes ? el('p', { class: 'small', text: a.notes }) : null,
        el('div', { class: 'bar-btns' }, actions.map(([st, label]) => el('button', { type: 'button', class: 'chip', text: label, on: { click: () => set(st) } }))));
    };

    let apptSeq = 0;
    const loadAppts = async () => {
      const mine = ++apptSeq;
      $('appt-msg').textContent = 'Loading…';
      try {
        const d = await hq(`?view=appointments&status=${chatState.appt}`);
        if (mine !== apptSeq) return;
        $('appt-list').replaceChildren(...d.appointments.map(apptItem));
        $('appt-msg').textContent = d.appointments.length ? 'Requests are not bookings until you confirm them with the visitor.' : 'No appointments.';
        loadChatBadges();
      } catch (err) {
        if (mine !== apptSeq) return;
        if (err instanceof AuthError) return signOut('Your session ended. Sign in again.');
        $('appt-msg').textContent = err.message;
      }
    };
    const loadChatBadges = () => hq('?view=conversations&limit=1').then((d) => { setBadge('badge-chats', d.needHuman); setBadge('badge-appts', d.openAppointments); setBadge('badge-calls', d.openCallbacks); }, () => {});

    const callItem = (c) => {
      const set = async (status) => {
        try { await hq(`?view=callbacks&id=${encodeURIComponent(c.id)}`, { method: 'PATCH', body: JSON.stringify({ status }) }); loadCalls(); }
        catch (err) { if (err instanceof AuthError) signOut('Your session ended. Sign in again.'); else $('call-msg').textContent = err.message; }
      };
      const actions = c.status === 'requested' ? [['called', 'Mark called'], ['no_answer', 'No answer'], ['closed', 'Close']] : c.status === 'no_answer' ? [['called', 'Mark called'], ['closed', 'Close']] : [];
      return el('li', { class: 'card' },
        el('h3', { text: c.name }),
        el('p', { class: 'mono', text: `${when(c.created_at)} · ${CALL_LABEL[c.status] || c.status}${c.best_time ? ` · Best time: ${c.best_time}` : ''}` }),
        el('p', { class: 'small', text: c.message }),
        el('div', { class: 'bar-btns' },
          el('a', { class: 'btn', href: `tel:${phoneDigits(c.phone)}`, text: `Call ${c.phone}` }),
          el('a', { class: 'btn ghost', href: `sms:${phoneDigits(c.phone)}`, text: 'Text' }),
          actions.map(([st, label]) => el('button', { type: 'button', class: 'chip', text: label, on: { click: () => set(st) } }))),
        c.email && EMAIL.test(c.email) ? el('p', { class: 'mono hint', text: c.email }) : null);
    };

    let callSeq = 0;
    const loadCalls = async () => {
      const mine = ++callSeq;
      $('call-msg').textContent = 'Loading…';
      try {
        const d = await hq(`?view=callbacks&status=${chatState.call}`);
        if (mine !== callSeq) return;
        $('call-list').replaceChildren(...d.callbacks.map(callItem));
        $('call-msg').textContent = d.callbacks.length ? '' : 'No callbacks.';
        loadChatBadges();
      } catch (err) {
        if (mine !== callSeq) return;
        if (err instanceof AuthError) return signOut('Your session ended. Sign in again.');
        $('call-msg').textContent = err.message;
      }
    };

    const buildChatFilters = () => {
      $('chat-filters').replaceChildren(...[['all', 'All chats'], ['human', 'Needs a person']].map(([v, l]) =>
        el('button', { type: 'button', class: 'chip', 'aria-pressed': String(chatState.filter === v), text: l,
          on: { click: () => { chatState.filter = v; buildChatFilters(); loadChats(); } } })));
      $('call-filters').replaceChildren(...[['open', 'To call back'], ['called', 'Called'], ['no_answer', 'No answer'], ['all', 'All']].map(([v, l]) =>
        el('button', { type: 'button', class: 'chip', 'aria-pressed': String(chatState.call === v), text: l,
          on: { click: () => { chatState.call = v; buildChatFilters(); loadCalls(); } } })));
      $('appt-filters').replaceChildren(...[['open', 'Open'], ['requested', 'Requested'], ['completed', 'Completed'], ['cancelled', 'Cancelled'], ['all', 'All']].map(([v, l]) =>
        el('button', { type: 'button', class: 'chip', 'aria-pressed': String(chatState.appt === v), text: l,
          on: { click: () => { chatState.appt = v; buildChatFilters(); loadAppts(); } } })));
    };

    // ----------------------------------------------------------------- tabs

    const tabs = [...document.querySelectorAll('[role="tab"]')];
    const selectTab = (tab) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        $(t.getAttribute('aria-controls')).hidden = !on;
      });
      // Load the traffic view the first time it is opened, so signing in stays fast.
      if (tab.id === 'tab-analytics' && !$('an-body').childElementCount) loadAnalytics();
      if (tab.id === 'tab-chats') loadChats();
      if (tab.id === 'tab-appts') loadAppts();
      if (tab.id === 'tab-calls') loadCalls();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : e.key === 'Home' ? -tabs.length : e.key === 'End' ? tabs.length - 1 : 0;
        if (e.key === 'Home') { selectTab(tabs[0]); tabs[0].focus(); return; }
        if (e.key === 'End') { const t = tabs[tabs.length - 1]; selectTab(t); t.focus(); return; }
        if (!d) return;
        const next = tabs[(i + d + tabs.length) % tabs.length];
        selectTab(next); next.focus();
      });
    });

    // ------------------------------------------------------------- listeners

    $('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.submitter || e.target.querySelector('button');
      token = $('token').value.trim();
      if (!token) return;
      btn.disabled = true; $('login-msg').textContent = 'Checking…';
      try {
        await loadLeads(false, true);
        try { sessionStorage.setItem(KEY, token); } catch {}
        $('login-msg').textContent = '';
        loadChatBadges();
      } catch (err) {
        if (!(err instanceof AuthError)) { $('login-msg').textContent = err.message; show(false); }
        else { token = ''; $('login-msg').textContent = err.message; $('token').focus(); }
      } finally {
        btn.disabled = false;
      }
    });
    $('logout').addEventListener('click', () => signOut());
    $('refresh').addEventListener('click', () => {
      const on = (id) => $(id).getAttribute('aria-selected') === 'true';
      if (on('tab-chats')) return loadChats();
      if (on('tab-appts')) return loadAppts();
      if (on('tab-calls')) return loadCalls();
      (on('tab-analytics') ? loadAnalytics() : loadLeads()).catch(() => {});
    });
    $('more').addEventListener('click', () => { state.offset = state.leads.length; loadLeads(true).catch(() => {}); });
    $('unsent').addEventListener('change', (e) => { state.unsent = e.target.checked; loadLeads().catch(() => {}); });
    let timer;
    $('q').addEventListener('input', (e) => { clearTimeout(timer); timer = setTimeout(() => { state.q = e.target.value.trim(); loadLeads().catch(() => {}); }, 300); });

    buildFilters();
    buildRanges();
    buildChatFilters();
    if (token) { show(true); loadLeads().catch(() => {}); loadChatBadges(); }
  </script>

  <style is:global>
    :root { --ink: #10280B; --ink-rgb: 16 40 11; --bone: #F8F3E7; --bg: #F2E9D6; --paper: #FCF9F1; --sand-2: #E4E8D2; --clay: #0E4A06; --clay-hover: #073602; --gold: #C98A00; --rust: #7A3300; --muted: #5C5546; --line: rgb(16 40 11 / .14); --display: "Gloock", serif; --serif: "Source Serif 4", Georgia, serif; --mono: "IBM Plex Mono", monospace; }
    *, *::before, *::after { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 1.0625rem/1.55 var(--serif); }
    #app { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
    h1, h2, h3 { font-family: var(--display); font-weight: 400; margin: 0; }
    h1 { font-size: 2rem; } h2 { font-size: 1.5rem; margin-bottom: 1rem; } h3 { font-size: 1.15rem; margin-bottom: .35rem; }
    .mono { font-family: var(--mono); font-size: .75rem; letter-spacing: .04em; }
    .muted { color: var(--muted); }
    .small { font-size: .9rem; }
    .top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .who { color: var(--muted); margin: 0; }
    :focus-visible { outline: 2px solid var(--clay); outline-offset: 2px; box-shadow: 0 0 0 5px var(--bone); }
    #login { max-width: 420px; background: var(--paper); border: 1px solid var(--line); padding: 1.5rem; }
    label { display: block; font: 600 .875rem var(--serif); }
    input, select, textarea { display: block; width: 100%; margin-top: .3rem; font: 1rem var(--serif); color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 2px; padding: .7em .8em; min-height: 44px; }
    textarea { resize: vertical; }
    #login-form { display: grid; gap: 1rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .6em 1.2em; background: var(--clay); color: var(--bone); border: 1px solid var(--clay); font: 500 .75rem var(--mono); letter-spacing: .08em; text-transform: uppercase; text-decoration: none; cursor: pointer; }
    .btn:hover { background: var(--clay-hover); }
    .btn:disabled { opacity: .6; cursor: default; }
    .btn.ghost { background: transparent; color: var(--ink); border-color: var(--ink); }
    .btn.ghost:hover { background: var(--ink); color: var(--bone); }
    .msg { min-height: 1.4em; margin: 0; font-size: .9rem; color: var(--muted); }
    #login-msg { color: var(--rust); }

    .tabs { display: flex; flex-wrap: wrap; gap: .25rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
    .tabs button { min-height: 44px; padding: .6em 1em; background: none; border: 0; border-bottom: 3px solid transparent; color: var(--muted); font: 600 .95rem var(--display); cursor: pointer; }
    .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--gold); }
    .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .bar p { margin: 0; color: var(--muted); }
    .bar-btns { display: flex; gap: .5rem; }
    .filters, .range { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
    .chip { min-height: 44px; padding: .5em 1em; background: transparent; border: 1px solid var(--ink); color: var(--ink); font: .75rem var(--mono); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
    .chip[aria-pressed="true"] { background: var(--ink); color: var(--bone); }
    .search-row { display: flex; gap: 1rem; align-items: end; flex-wrap: wrap; margin-bottom: .5rem; }
    .grow { flex: 1 1 260px; }
    .check { display: flex; align-items: center; gap: .5rem; min-height: 44px; font-weight: 400; }
    .check input { width: 22px; height: 22px; margin: 0; min-height: 0; }

    #list { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: .75rem; }
    .lead { background: var(--paper); border: 1px solid var(--line); }
    .lead summary { display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; padding: .9rem 1rem; cursor: pointer; min-height: 44px; list-style-position: inside; }
    .row-main { display: grid; gap: .1rem; min-width: 0; }
    .row-main strong { font-size: 1.1rem; overflow-wrap: anywhere; }
    .sub { color: var(--muted); }
    .badges { display: flex; flex-wrap: wrap; gap: .4rem; }
    .badge { font: .75rem var(--mono); padding: .2em .6em; border: 1px solid var(--line); background: var(--bone); }
    .badge.s-new { background: var(--ink); color: var(--bone); border-color: var(--ink); }
    .badge.warn { background: #fff3d6; border-color: var(--gold); color: var(--rust); }
    .lead details > :not(summary) { margin-left: 1rem; margin-right: 1rem; }
    .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 0; margin-bottom: 1rem; }
    .details { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .8rem 1.2rem; margin-bottom: 1rem; }
    .details dt { color: var(--muted); } .details dd { margin: .1rem 0 0; overflow-wrap: anywhere; }
    .wide { grid-column: 1 / -1; }
    .notes { white-space: pre-wrap; }
    .edit { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 1rem 0 1.25rem; border-top: 1px solid var(--line); }
    .edit .msg { margin-top: .5rem; }
    #more { display: block; margin: 0 auto; }

    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; margin-bottom: 1rem; }
    .stat { background: var(--paper); border: 1px solid var(--line); border-top: 3px solid var(--gold); padding: .9rem 1rem; }
    .stat .k { color: var(--muted); margin: 0 0 .3rem; text-transform: uppercase; letter-spacing: .1em; font-size: .7rem; }
    .stat .v { font: 400 2rem var(--display); margin: 0; line-height: 1; }
    .stat .s { color: var(--muted); margin: .3rem 0 0; font-size: .7rem; }
    .plain { list-style: none; padding: 0; margin: 0; }
    .badge { display: inline-block; min-width: 1.4em; padding: 0 .4em; margin-left: .3em; background: var(--rust); color: var(--bone); border-radius: 999px; font: 500 .75rem var(--mono); text-align: center; }
    .flag { color: var(--rust); font-weight: 600; }
    .thread { margin: .8rem 0; display: grid; gap: .4rem; }
    .bubble { margin: 0; padding: .5rem .75rem; font-size: .95rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .bubble.user { background: var(--sand-2); }
    .bubble.assistant { background: var(--paper); border: 1px solid var(--line); }
    summary { cursor: pointer; }
    .card { background: var(--paper); border: 1px solid var(--line); padding: 1.1rem 1.25rem; margin-bottom: .75rem; }
    .card .hint { color: var(--muted); margin: 0 0 .9rem; }
    .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: .75rem; align-items: start; }
    .bars { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
    .bars li { display: grid; grid-template-columns: minmax(90px, 34%) 1fr auto; gap: .6rem; align-items: center; font-size: .9rem; }
    .bl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bt { background: var(--sand-2); height: .7rem; border-radius: 999px; overflow: hidden; }
    .bf { display: block; height: 100%; background: var(--clay); border-radius: 999px; }
    .bv { font: .75rem var(--mono); color: var(--muted); min-width: 2.5ch; text-align: right; }
    .chart { display: flex; align-items: flex-end; gap: 2px; height: 150px; }
    .col { flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: .3rem; }
    .plot { flex: 1; min-height: 0; width: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
    .stack { display: block; width: 100%; background: var(--clay); min-height: 2px; }
    .stack.pv { background: var(--gold); }
    .plot > :first-child { border-radius: 2px 2px 0 0; }
    .lbl { font: .75rem var(--mono); color: var(--muted); white-space: nowrap; height: 1.2em; overflow: visible; align-self: flex-start; }
    .lbl.end { align-self: flex-end; } /* near the right edge, grow leftwards so the label never pushes the page wider */
    .hours { display: flex; align-items: flex-end; gap: 2px; height: 100px; }
    .hr { flex: 1; background: var(--clay); border-radius: 2px 2px 0 0; min-height: 2px; }
    .footnote { color: var(--muted); line-height: 1.6; margin: 1rem 0 0; }
    @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
  </style>
</body>
</html>
