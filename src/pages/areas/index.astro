---
import Layout from '../../layouts/Layout.astro';
import { site, communities, serviceAreaNames, areaUrl, offer, usd } from '../../data/site';
import { breadcrumb, webPage } from '../../data/schema';

const path = '/areas/';
const title = `Areas We Serve | ${site.name}`;
const description = `${site.name} builds in Tehachapi, home of the Sunset Retreat release, and takes inquiries from buyers across eastern Kern County. Ask us to confirm availability in your area.`;
const published = communities.filter((c) => c.published);
const schema = [webPage(path, title, description), breadcrumb([['Home', '/'], ['Areas we serve', path]])];
---
<Layout title={title} description={description} schema={schema}>
  <section class="section wrap">
    <nav class="mono crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Areas we serve</span></nav>
    <p class="eyebrow">Areas we serve</p>
    <h1>Where Aspen II Homes <em>builds.</em></h1>
    <p class="lede">We're based in Tehachapi, home of our current <a href="/available-homes/">{offer.community} release</a> from {usd(offer.from)}. We also take inquiries from buyers in nearby communities; availability is confirmed case by case.</p>
  </section>

  <section class="section areas">
    <div class="wrap grid">
      {published.map((c) => (
        <a class="area live" href={areaUrl(c)}>
          <p class="mono k">Building now</p>
          <h2>{c.name}</h2>
          <p>{c.short}</p>
          <span class="mono">Explore {c.name} →</span>
        </a>
      ))}
      <div class="area">
        <p class="mono k">Inquiries welcome</p>
        <h2>Nearby communities</h2>
        <ul>{serviceAreaNames.filter((n) => !published.some((c) => c.name === n)).map((n) => <li>{n}</li>)}</ul>
        <p>Tell us where your land is, or where you're looking, and we'll confirm what's possible there.</p>
        <a class="btn" href="/build-on-your-lot/">Build on your lot</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .crumbs { color: var(--muted); font-size: .68rem; margin-bottom: 2rem; } .crumbs a { text-decoration: none; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
  .lede { max-width: 60ch; font-size: 1.15rem; color: var(--muted); } .lede a { color: var(--clay); }
  .areas { background: var(--sand-2); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.25rem; }
  .area { background: var(--paper); border: 1px solid var(--line); padding: 2rem; display: flex; flex-direction: column; gap: .4rem; text-decoration: none; }
  .area.live { background: var(--ink); color: var(--bone); }
  .area .k { font-size: .64rem; color: var(--clay); margin: 0; } .area.live .k { color: var(--gold); }
  .area h2 { font-size: 1.8rem; margin: .2rem 0; }
  .area ul { padding-left: 1.1rem; margin: .4rem 0; }
  .area .btn { align-self: start; margin-top: .8rem; }
  .area.live .mono:last-child { color: var(--gold); margin-top: auto; font-size: .7rem; }
</style>
