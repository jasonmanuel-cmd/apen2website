---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/site';
interface Props { images: Photo[]; name: string }
const { images, name } = Astro.props;
const full = await Promise.all(images.map((p) => getImage({ src: p.src, width: 1600 })));
const shown = 9; // big tile + two rows of four fills the grid evenly; the rest open in the lightbox
---
<div class="gallery" data-gallery>
  {images.map((p, i) => (
    <button type="button" class:list={['tile', { big: i === 0, hidden: i >= shown }]} data-full={full[i].src} data-caption={p.caption}
      aria-label={`Open photo: ${p.caption || `${i + 1} of ${images.length}`}`}>
      <Image src={p.src} alt={`${name}: ${p.caption}`} widths={[400, 800]} sizes={i === 0 ? '(max-width: 700px) 100vw, 66vw' : '(max-width: 700px) 50vw, 33vw'} />
      {p.caption && <span class="cap mono">{p.caption}</span>}
      {i === shown - 1 && images.length > shown && <span class="more mono">+{images.length - shown} photos</span>}
    </button>
  ))}
  <dialog class="lightbox" aria-label={`${name} photos`}>
    <figure><img alt="" /><figcaption class="mono"></figcaption></figure>
    <button type="button" class="nav prev" aria-label="Previous photo">‹</button>
    <button type="button" class="nav next" aria-label="Next photo">›</button>
    <button type="button" class="close" aria-label="Close">×</button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const tiles = [...g.querySelectorAll<HTMLButtonElement>('.tile')];
    const dlg = g.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + tiles.length) % tiles.length;
      img.src = tiles[i].dataset.full!;
      img.alt = tiles[i].querySelector('img')!.alt;
      cap.textContent = `${tiles[i].dataset.caption || ''}  ·  ${i + 1} / ${tiles.length}`;
    };
    tiles.forEach((t, n) => t.addEventListener('click', () => { show(n); dlg.showModal(); }));
    dlg.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.next')!.addEventListener('click', () => show(i + 1));
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    // swipe on phones
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(i + (dx < 0 ? 1 : -1)); });
  });
</script>

<style>
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .tile { position: relative; padding: 0; border: 0; cursor: zoom-in; overflow: hidden; aspect-ratio: 3/2; background: var(--sand); }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .tile:hover img { transform: scale(1.04); }
  .hidden { display: none; }
  .big { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .cap { position: absolute; left: 0; bottom: 0; padding: .4rem .6rem; font-size: .58rem; color: var(--bone); background: linear-gradient(transparent, rgb(var(--ink-rgb) / .75)); width: 100%; text-align: left; opacity: 0; transition: opacity .3s; }
  .tile:hover .cap, .tile:focus-visible .cap { opacity: 1; }
  .more { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(var(--ink-rgb) / .6); color: var(--bone); font-size: .8rem; }
  @media (max-width: 700px) { .gallery { grid-template-columns: 1fr 1fr; } .big { grid-column: span 2; grid-row: auto; aspect-ratio: 3/2; } .cap { opacity: 1; } }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgb(var(--ink-rgb) / .95); }
  .lightbox[open] { display: grid; place-items: center; }
  figure { margin: 0; display: grid; justify-items: center; gap: .8rem; }
  .lightbox img { max-width: min(92vw, 1600px); max-height: 82vh; object-fit: contain; }
  figcaption { color: var(--sand); font-size: .7rem; white-space: pre; }
  .lightbox button { position: fixed; background: rgb(var(--bone-rgb) / .1); color: var(--bone); border: 0; font-size: 2rem; width: 52px; height: 52px; cursor: pointer; border-radius: 50%; }
  .lightbox button:hover { background: rgb(var(--bone-rgb) / .22); }
  .prev { left: 16px; top: 50%; } .next { right: 16px; top: 50%; } .close { right: 16px; top: 16px; }
</style>
