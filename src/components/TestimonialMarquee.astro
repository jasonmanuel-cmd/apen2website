---
const items = [
  { source: 'BuildZoom Top 2%', text: 'Ranked in the top 2% of over 336,000 licensed California contractors.', tag: 'Verified License' },
  { source: 'BBB Accredited', text: 'A+ Rating with the Better Business Bureau. Serving Tehachapi with integrity since 1994.', tag: 'A+ Accreditation' },
  { source: 'Tehachapi Homeowner', text: '"The structural quality and insulation in our Sunset Retreat home is outstanding through mountain winter storms."', tag: 'Verified Buyer' },
  { source: 'Local Mountain Craft', text: 'Engineered specifically for Tehachapi 4,000 ft elevation snow loads and high wind codes.', tag: 'Structural Engineering' },
  { source: 'First-Time Buyer', text: '"They walked us through every step of the 0% down program and helped us customize our dream kitchen."', tag: 'Financing Success' },
  { source: 'CSLB #1004058', text: 'Class B General Building Contractor. Continuous local family ownership for over three decades.', tag: 'Heritage' },
];
---

<div class="marquee-section" aria-label="Accreditations and client testimonials">
  <div class="marquee-track-wrap">
    <div class="marquee-track">
      <!-- First set -->
      {items.map((item) => (
        <div class="marquee-card">
          <div class="card-head">
            <span class="mono card-tag">{item.tag}</span>
            <span class="star-rating" aria-hidden="true">★★★★★</span>
          </div>
          <p class="card-text">{item.text}</p>
          <div class="card-author mono">
            <span class="author-dot" aria-hidden="true"></span>
            <strong>{item.source}</strong>
          </div>
        </div>
      ))}
      <!-- Duplicate set for seamless continuous loop -->
      {items.map((item) => (
        <div class="marquee-card" aria-hidden="true">
          <div class="card-head">
            <span class="mono card-tag">{item.tag}</span>
            <span class="star-rating">★★★★★</span>
          </div>
          <p class="card-text">{item.text}</p>
          <div class="card-author mono">
            <span class="author-dot"></span>
            <strong>{item.source}</strong>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-section {
    position: relative;
    padding: 3.5rem 0;
    overflow: hidden;
    background: var(--ink) var(--topo-light);
    background-size: 480px;
    color: var(--bone);
    border-top: 1px solid rgb(var(--bone-rgb) / .15);
    border-bottom: 1px solid rgb(var(--bone-rgb) / .15);
  }

  .marquee-track-wrap {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marquee-scroll 38s linear infinite;
  }
  .marquee-track:hover { animation-play-state: paused; }

  .marquee-card {
    flex: 0 0 340px;
    background: rgb(var(--ink-rgb) / .75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgb(var(--bone-rgb) / .14);
    border-radius: 6px;
    padding: 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: .8rem;
    transition: transform .25s ease, border-color .25s ease;
  }
  .marquee-card:hover {
    transform: translateY(-3px);
    border-color: var(--gold);
    box-shadow: 0 12px 30px rgb(0 0 0 / .35);
  }

  .card-head { display: flex; justify-content: space-between; align-items: center; }
  .card-tag { font-size: .68rem; color: var(--gold); letter-spacing: .08em; text-transform: uppercase; }
  .star-rating { color: var(--gold); font-size: .82rem; letter-spacing: 2px; }

  .card-text { font-size: .92rem; line-height: 1.55; color: var(--bone); opacity: .94; margin: 0; }

  .card-author { display: flex; align-items: center; gap: .5rem; font-size: .75rem; color: var(--on-dark-muted); }
  .author-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 0.75rem)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; overflow-x: auto; }
  }
</style>
