---
import { site, usd, type Plan, theName } from '../data/site';

interface Props {
  plan: Plan;
  label: string;
}

const { plan, label } = Astro.props;
const priceText = plan.price ? usd(plan.price) : 'Call for Pricing';
---

<aside class="sticky-bar" id="plan-sticky-bar" aria-label="Quick floor plan actions" hidden>
  <div class="wrap bar-inner">
    <div class="bar-info">
      <div class="bar-headline">
        <span class="bar-name">{label}</span>
        {plan.status && <span class="bar-status mono">{plan.status}</span>}
      </div>
      <div class="bar-specs mono">
        <span>{plan.sqft.toLocaleString('en-US')} sf</span>
        <span class="sep">/</span>
        <span>{plan.beds} Bed</span>
        <span class="sep">/</span>
        <span>{plan.baths} Bath</span>
        <span class="sep">/</span>
        <span class="bar-price">{plan.price ? `From ${priceText}` : priceText}</span>
      </div>
    </div>

    <div class="bar-ctas">
      <a class="btn-subtle mono" href={site.phoneHref} aria-label={`Call ${site.phone}`}><span class="call-long">Call {site.phone}</span><span class="call-short" aria-hidden="true">Call</span></a>
      <a class="btn btn-sm" href="#inquire" aria-label={plan.firstRelease ? 'Reserve & Customize' : 'Schedule Private Tour'}><span class="call-long">{plan.firstRelease ? 'Reserve & Customize' : 'Schedule Private Tour'}</span><span class="call-short" aria-hidden="true">{plan.firstRelease ? 'Reserve' : 'Book a Tour'}</span></a>
    </div>
  </div>
</aside>

<script>
  function initStickyBar() {
    const bar = document.getElementById('plan-sticky-bar');
    const inquireSection = document.getElementById('inquire');
    if (!bar) return;

    let heroPassed = false;
    let inquireVisible = false;

    function update() {
      const on = heroPassed && !inquireVisible;
      const b = bar as HTMLElement;
      if (on) {
        b.removeAttribute('hidden');
        requestAnimationFrame(() => {
          b.classList.add('is-visible');
          // Lets the chat button (and anything else floating) sit above the bar instead of under it.
          document.documentElement.style.setProperty('--plan-bar-h', `${b.offsetHeight}px`);
        });
      } else {
        b.classList.remove('is-visible');
      }
      document.documentElement.classList.toggle('plan-bar-on', on);
    }

    // Scroll listener for hero threshold
    const onScroll = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      heroPassed = scrollY > 400;
      update();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // IntersectionObserver to hide bar when inquire form is on screen
    if (inquireSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inquireVisible = entry.isIntersecting;
            update();
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(inquireSection);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyBar);
  } else {
    initStickyBar();
  }
</script>

<style>
  .sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: rgba(22, 28, 24, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.25);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
    opacity: 0;
    pointer-events: none;
    padding: 0.75rem 0;
  }

  .sticky-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .bar-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bar-headline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bar-name {
    font-family: var(--display);
    font-size: 1.15rem;
    color: var(--bone);
  }

  .bar-status {
    font-size: 0.68rem;
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .bar-status::before {
    content: "●";
    color: var(--gold);
    font-size: 0.7rem;
    animation: bar-pulse 1.8s infinite;
  }

  @keyframes bar-pulse {
    50% { opacity: 0.3; }
  }

  .bar-specs {
    font-size: 0.75rem;
    color: var(--on-dark-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .sep {
    opacity: 0.4;
  }

  .bar-price {
    color: var(--gold);
    font-weight: 500;
  }

  .bar-ctas {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-sm {
    padding: 0.65rem 1.25rem;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .btn-subtle {
    color: var(--on-dark-muted);
    font-size: 0.72rem;
    text-decoration: none;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .call-short { display: none; }

  .btn-subtle:hover {
    color: var(--bone);
    border-color: var(--gold);
  }

  @media (max-width: 720px) {
    .sticky-bar {
      padding: 0.65rem 0 calc(0.65rem + env(safe-area-inset-bottom));
    }
    .bar-specs span:not(.bar-price) {
      display: none;
    }
    .bar-specs .sep {
      display: none;
    }
    /* One compact row on phones: name + price, then Call and Reserve. */
    .bar-status {
      display: none;
    }
    .bar-inner {
      gap: 0.6rem;
    }
    .btn-subtle {
      padding: 0.55rem 0.8rem;
    }
    .call-long {
      display: none;
    }
    .call-short {
      display: inline;
    }
    .bar-name {
      font-size: 1rem;
      white-space: nowrap;
    }
    .btn-sm {
      padding: 0.55rem 1rem;
      font-size: 0.78rem;
    }
  }
  @media (max-width: 360px) {
    /* Smallest phones: the site's Call link stays in the header menu and footer. */
    .btn-subtle { display: none; }
  }
</style>
