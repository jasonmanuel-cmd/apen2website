---
import { site, plans, communities, offer, usd } from '../data/site';
interface Props { plan?: string; community?: string; interest?: string; source?: string; dark?: boolean; compact?: boolean }
// compact: for pages with no model/community context (the contact page); those two choices move into "Tell us more".
const { plan = '', community = '', interest = '', source = 'Website', dark = false, compact = false } = Astro.props;
const interests = [
  ['reserve', `Reserve & customize a ${offer.community} home (from ${usd(offer.from)})`],
  ['semi', 'Choose a model (semi-custom)'],
  ['financing', 'Financing & incentives'],
  ['tour', 'Schedule a tour'],
  ['va', 'VA / military financing'],
  ['unsure', 'Not sure yet, help me decide'],
];
---
<form class:list={['lead', { dark }]} action="/api/lead" method="post" data-lead aria-label="Request information">
  <input type="hidden" name="source" value={source} />
  <div class="hp" aria-hidden="true" inert><label>Leave blank <input name="honeypot" tabindex="-1" autocomplete="off" /></label></div>
  <p class="req mono" aria-hidden="true">* required</p>
  <div class="row">
    <label><span>Name <span aria-hidden="true">*</span></span><input name="name" required autocomplete="name" spellcheck="false" /></label>
    <label><span>Phone <span aria-hidden="true">*</span></span><input name="phone" type="tel" required autocomplete="tel" /></label>
  </div>
  <label>Email<input name="email" type="email" autocomplete="email" spellcheck="false" /></label>
  <label>I'm interested in
    <select name="timeline" data-interest>
      {interests.map(([v, l]) => <option value={l} data-key={v} selected={v === interest}>{l}</option>)}
    </select>
  </label>
  {!compact && (
  <div class="row">
    <label>Model
      <select name="plan">
        <option value="">Not sure yet</option>
        {plans.map((p) => <option selected={p.name === plan}>{p.name}</option>)}
      </select>
    </label>
    <label>Community
      <select name="community">
        <option value="">Not sure yet</option>
        {communities.map((c) => <option selected={c.name === community}>{c.name}</option>)}
      </select>
    </label>
  </div>
  )}
  <details class="more">
    <summary class="mono">Tell us more (optional)</summary>
    {compact && (
    <div class="row">
      <label>Model
        <select name="plan">
          <option value="">Not sure yet</option>
          {plans.map((p) => <option selected={p.name === plan}>{p.name}</option>)}
        </select>
      </label>
      <label>Community
        <select name="community">
          <option value="">Not sure yet</option>
          {communities.map((c) => <option selected={c.name === community}>{c.name}</option>)}
        </select>
      </label>
    </div>
    )}
    <div class="row">
      <label>Best way to reach you
        <select name="contactPref"><option value="">Any</option><option>Call</option><option>Text</option><option>Email</option></select>
      </label>
      <label>Where are you in the process?
        <select name="stage"><option value="">Choose one</option><option>Ready to buy now</option><option>Researching</option></select>
      </label>
    </div>
    <div class="row">
      <label>Timeline
        <select name="when"><option value="">Not sure</option><option>Within 3 months</option><option>3 to 6 months</option><option>6 to 12 months</option><option>More than a year</option></select>
      </label>
      <label>Budget
        <select name="budget"><option value="">Prefer not to say</option><option>Under $400K</option><option>$400K to $500K</option><option>$500K to $650K</option><option>Over $650K</option></select>
      </label>
    </div>
    <fieldset class="checks">
      <legend class="mono">Ask me about</legend>
      <label class="check"><input type="checkbox" name="firstTime" value="yes" /> First-time buyer options</label>
      <label class="check"><input type="checkbox" name="military" value="yes" /> VA / military options</label>
    </fieldset>
  </details>
  <label>When works for you? Anything we should know?<textarea name="notes" rows="3" maxlength="3000"></textarea></label>
  <button class="btn" type="submit">Send My Request <span aria-hidden="true">→</span></button>
  <p class="consent">By sending, you agree we may call, text or email you about this request. We won't send marketing messages without your permission. See our <a href="/privacy/">privacy notice</a>.</p>
  <p class="status mono" role="status" aria-live="polite" tabindex="-1">No spam. No pressure. We reply {site.followUp}. Prefer to text? <a href={site.sms()}>Text HOMES to {site.phone}</a></p>
</form>

<script>
  import { site } from '../data/site';
  // ?interest=reserve|custom|… preselects the dropdown (used by CTA links).
  const want = new URLSearchParams(location.search).get('interest');
  if (want) document.querySelectorAll<HTMLSelectElement>('select[data-interest]').forEach((s) => {
    const o = [...s.options].find((o) => o.dataset.key === want);
    if (o) s.value = o.value;
  });
  // Progressive enhancement: without JS the form still posts to /api/lead.
  document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      const status = form.querySelector('.status')!;
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) throw new Error();
        form.classList.add('sent');
        status.textContent = "Thank you! Our team will reach out shortly.";
        // The focused button is now hidden; move focus to the confirmation so keyboard and screen-reader users aren't dropped.
        (status as HTMLElement).focus();
      } catch {
        btn.disabled = false; btn.innerHTML = 'Send My Request <span aria-hidden="true">→</span>';
        status.innerHTML = `Something went wrong. Please call <a href="${site.phoneHref}">${site.phone}</a>.`;
      }
    });
  });
</script>

<style>
  .lead { display: grid; gap: 1rem; }
  .more { border: 1px solid var(--line); padding: .8rem 1rem; }
  .more[open] { display: grid; gap: 1rem; }
  .more summary { cursor: pointer; font-size: .8rem; padding: .7rem 0; margin: -.7rem 0; }
  .checks { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; }
  .checks legend { font-size: .68rem; margin-bottom: .4rem; }
  .check { display: flex; align-items: center; gap: .5rem; font-weight: 400; }
  .check input { width: auto; }
  .consent { font-size: .82rem; margin: 0; opacity: .85; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
  label { display: grid; gap: .35rem; font: .75rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  input, select, textarea { font: 1rem var(--serif); color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 2px; padding: .8em .9em; width: 100%; min-width: 0; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--clay); outline-offset: 0; box-shadow: 0 0 0 4px var(--bone); }
  .hp { position: absolute; left: -9999px; }
  .status { font-size: .75rem; color: var(--muted); margin: 0; }
  .req { font-size: .75rem; color: var(--muted); margin: 0; }
  .status a { color: var(--clay); }
  .status:focus { outline: none; box-shadow: none; }
  .sent > :not(.status) { display: none; }
  .sent .status { font: 1.5rem var(--display); text-transform: none; letter-spacing: 0; color: var(--ink); }
  .dark label, .dark .status, .dark .req { color: var(--on-dark-muted); }
  .dark .status a { color: var(--gold); }
  .dark.sent .status { color: var(--bone); }
</style>
