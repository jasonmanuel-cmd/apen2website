---
import { Image } from 'astro:assets';
import { type Plan, usd, photos, blueprint, planUrl } from '../data/site';
const { plan } = Astro.props as { plan: Plan };
const first = photos(plan.folder)[0];
const cover = first?.src;
const name = plan.slug === 'sunset-retreat' ? `${plan.name} Model` : plan.name;
const bp = cover ? undefined : blueprint(plan.folder);
---
<a class="card-3d-wrap" href={planUrl(plan)} data-3d-card aria-label={`${name}, ${plan.sqft} sq ft, ${plan.beds} beds, ${plan.baths} baths`}>
  <div class="card-3d-inner" data-3d-inner>
    <div class="card-glare" data-3d-glare aria-hidden="true"></div>
    <div class:list={['media', { plan: bp }]}>
      {cover && <Image src={cover} alt={`${name}${first?.caption ? `: ${first.caption.toLowerCase()}` : ''}${plan.rendering ? ' (artist rendering)' : ''}`} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 400px" />}
      {bp && <Image src={bp} alt={`${plan.name} floor plan`} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 400px" />}
      <div class="tags">
        {plan.firstRelease && <span class="tag mono hot"><span class="dot" aria-hidden="true"></span> Now reserving</span>}
        {plan.rendering && <span class="tag mono">Rendering</span>}
        {bp && <span class="tag mono">Floor plan</span>}
        {plan.stories === 2 && <span class="tag mono right">Two-story</span>}
      </div>
    </div>
    <div class="body">
      <p class="mono kicker">{plan.tagline}</p>
      <h3 class="name">{name}</h3>
      <div class="specs">
        <span class="spec-pill">{plan.sqft.toLocaleString('en-US')} sq ft</span>
        <span class="spec-sep" aria-hidden="true">·</span>
        <span class="spec-pill">{plan.beds} bed</span>
        <span class="spec-sep" aria-hidden="true">·</span>
        <span class="spec-pill">{plan.baths} bath</span>
      </div>
      <div class="price-row">
        <div class="price">
          {plan.price ? (
            <>
              <span class="from-label mono">From</span>
              <strong>{usd(plan.price)}</strong>
            </>
          ) : (
            <span class="mono quote-label">Request current pricing</span>
          )}
        </div>
        <span class="arrow-btn mono" aria-hidden="true">
          <span>Explore</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .card-3d-wrap { display: block; text-decoration: none; perspective: 1000px; transform-style: preserve-3d; }
  .card-3d-inner { position: relative; display: flex; flex-direction: column; height: 100%; background: var(--bone);
                   border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
                   transition: transform .25s var(--ease), box-shadow .35s var(--ease), border-color .35s;
                   will-change: transform; }
  .card-3d-wrap:hover .card-3d-inner {
    border-color: var(--clay);
    box-shadow: 0 22px 50px -10px rgb(var(--ink-rgb) / .18), 0 0 0 1px var(--clay);
  }
  .card-glare { position: absolute; inset: 0; pointer-events: none; z-index: 5; opacity: 0;
                transition: opacity .35s ease; border-radius: inherit; }

  .media { position: relative; aspect-ratio: 3/2; overflow: hidden; background: var(--sand); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .media.plan { background: #fff; }
  .media.plan img { object-fit: contain; padding: 12px; }
  .card-3d-wrap:hover .media img { transform: scale(1.06); }

  .tags { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; gap: .5rem; pointer-events: none; }
  .tag { background: rgb(var(--ink-rgb) / .86); backdrop-filter: blur(8px); color: var(--bone);
         font-size: .72rem; padding: .4em .75em; border-radius: 2px; display: inline-flex; align-items: center; gap: .4em; }
  .tag.hot { background: var(--clay); color: var(--bone); box-shadow: 0 4px 12px rgb(14 74 6 / .3); }
  .tag.hot .dot { width: 6px; height: 6px; border-radius: 50%; background: #62E755; animation: pulse 1.6s infinite; }
  .tag.right { margin-left: auto; }
  @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .4; transform: scale(.8); } }

  .body { padding: 1.4rem 1.5rem 1.6rem; display: flex; flex-direction: column; flex: 1; }
  .kicker { color: var(--rust); font-size: .74rem; margin: 0 0 .35rem; letter-spacing: .1em; }
  .name { font-size: 1.6rem; margin: 0 0 .5rem; line-height: 1.1; color: var(--ink); }

  .specs { display: flex; align-items: center; gap: .5rem; font-family: var(--mono); font-size: .76rem; color: var(--muted); margin: 0 0 1.3rem; }
  .spec-pill { background: rgb(var(--ink-rgb) / .05); padding: .25em .6em; border-radius: 2px; }
  .spec-sep { opacity: .4; }

  .price-row { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line);
               display: flex; align-items: flex-end; justify-content: space-between; gap: .75rem; }
  .price { display: flex; flex-direction: column; }
  .from-label { font-size: .68rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .price strong { font-family: var(--display); font-size: 1.6rem; font-weight: 400; color: var(--clay); line-height: 1; }
  .quote-label { font-size: .78rem; color: var(--clay); font-weight: 500; }

  .arrow-btn { display: inline-flex; align-items: center; gap: .35rem; font-size: .74rem; text-transform: uppercase;
               letter-spacing: .08em; color: var(--ink); transition: color .25s var(--ease), transform .25s var(--ease); }
  .arrow-btn svg { transition: transform .25s var(--ease); }
  .card-3d-wrap:hover .arrow-btn { color: var(--clay); }
  .card-3d-wrap:hover .arrow-btn svg { transform: translateX(4px); }

  @media (hover: none) or (pointer: coarse) {
    .card-3d-wrap { perspective: none; }
    .card-3d-inner { transform: none !important; }
    .card-glare { display: none; }
  }

  @media (max-width: 500px) {
    .body { padding: 1.2rem 1.2rem 1.4rem; }
    .name { font-size: 1.45rem; }
    .specs { flex-wrap: wrap; gap: .35rem; }
    .price strong { font-size: 1.45rem; }
    .arrow-btn { min-height: 44px; }
  }
</style>

