---
import { Image } from 'astro:assets';
import { type Plan, usd, photos, blueprint } from '../data/site';
const { plan } = Astro.props as { plan: Plan };
const cover = photos(plan.folder)[0]?.src;
const bp = cover ? undefined : blueprint(plan.folder);
---
<a class="card" href={`/${plan.slug}/`}>
  <div class:list={['media', { plan: bp }]}>
    {cover && <Image src={cover} alt={`${plan.name} exterior`} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 400px" />}
    {bp && <Image src={bp} alt={`${plan.name} floor plan`} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 400px" />}
    {plan.firstRelease && <span class="tag mono hot">Now selling</span>}
    {plan.rendering && <span class="tag mono">Rendering</span>}
    {bp && <span class="tag mono">Floor plan</span>}
    {plan.stories === 2 && <span class="tag mono right">Two-story</span>}
  </div>
  <div class="body">
    <p class="mono kicker">{plan.tagline}</p>
    <h3>{plan.name}</h3>
    <p class="mono meta">{plan.sqft.toLocaleString()} sf · {plan.beds} bd · {plan.baths} ba</p>
    <p class="price">{plan.price ? <>From <strong>{usd(plan.price)}</strong></> : <span class="mono">Call for pricing</span>} <span class="arrow" aria-hidden="true">→</span></p>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; background: var(--bone); border: 1px solid var(--line); overflow: hidden;
          transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s; }
  .card:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(14,23,18,.12); border-color: var(--clay); }
  .media { position: relative; aspect-ratio: 3/2; overflow: hidden; background: var(--sand); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .media.plan { background: #fff; }
  .media.plan img { object-fit: contain; padding: 10px; }
  .card:hover .media img { transform: scale(1.05); }
  .tag { position: absolute; top: 12px; left: 12px; background: rgba(14,23,18,.82); color: var(--bone); font-size: .62rem; padding: .35em .7em; }
  .tag.hot { background: var(--clay); }
  .tag.right { left: auto; right: 12px; }
  .body { padding: 1.3rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .kicker { color: var(--clay); font-size: .64rem; margin: 0 0 .4rem; }
  .body h3 { margin-bottom: .3rem; }
  .meta { color: var(--muted); font-size: .72rem; margin: 0 0 1.2rem; }
  .price { margin: auto 0 0; padding-top: 1rem; border-top: 1px solid var(--line); display: flex; align-items: baseline; gap: .4rem; font-family: var(--mono); font-size: .8rem; }
  .price strong { font-family: var(--display); font-size: 1.45rem; font-weight: 400; color: var(--clay); }
  .arrow { margin-left: auto; transition: transform .3s var(--ease); }
  .card:hover .arrow { transform: translateX(4px); }
</style>
