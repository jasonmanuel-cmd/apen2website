---
import { site } from '../data/site';

interface Props {
  planName?: string;
}

const { planName } = Astro.props;

const standards = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>`,
    title: 'Snow & Wind Mountain Truss Engineering',
    tag: '30+ PSF Rated',
    desc: 'Engineered specifically for Tehachapi’s 4,000-ft alpine ridge lines with heavy snow-load roof trusses and high-wind mountain pass shear wall engineering.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    title: 'Dual-Pane Low-E Argon Alpine Windows',
    tag: 'UV & Frost Protection',
    desc: 'Spectrally selective Low-E glazing with argon gas fill blocks harsh high-elevation mountain ultraviolet rays while locking warmth inside during winter snowfalls.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
    title: 'Class-A Fire Resistant Exterior Shell',
    tag: 'Wildfire Hardened',
    desc: 'Non-combustible exterior finishes, Class-A architectural roofing shingles, and ember-resistant soffit venting built to California high-fire zone compliance.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'High-R Advanced Thermal Envelope',
    tag: 'R-38 / R-19 Spec',
    desc: 'Rigid air-barrier sealing combined with high-density thermal insulation keeps your indoor climate whispering quiet and energy bills exceptionally low.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Clean Electric & Solar-Ready Infrastructure',
    tag: 'Future-Proofed',
    desc: 'High-efficiency heat pump space conditioning, hybrid water heating, and pre-wired 200A service panel ready for rooftop solar arrays and Level-2 EV charging.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l8-4v18M13 7l6 3v11"/></svg>`,
    title: 'Seismic & Frost-Line Engineered Slab',
    tag: 'Reinforced Concrete',
    desc: 'Deep perimeter footings excavated below regional winter frost lines with high-tensile steel rebar reinforcement tailored to Tehachapi soil mechanics.',
  },
];
---

<section class="standards-section" aria-labelledby="standards-heading">
  <div class="wrap">
    <div class="standards-header">
      <div class="header-content">
        <p class="eyebrow">Alpine Durability & Quality</p>
        <h2 id="standards-heading">Built for the <em>4,000-ft mountain climate.</em></h2>
        <p class="standards-intro">
          Tehachapi is not the Central Valley or Southern California flatlands. Every home built by {site.name} incorporates cold-weather engineering, wildfire hardening, and high-efficiency thermal barriers that exceed baseline building codes.
        </p>
      </div>
      <div class="header-badge">
        <span class="cslb-tag mono">CSLB #1004058</span>
        <span class="badge-title">Engineered Standards</span>
        <span class="badge-desc">Zero shortcuts. Built for four distinct seasons.</span>
      </div>
    </div>

    <div class="standards-grid">
      {standards.map((s, idx) => (
        <article class="standard-card">
          <div class="card-top">
            <div class="icon-wrap" set:html={s.icon} />
            <span class="mono card-tag">{s.tag}</span>
          </div>
          <h3 class="card-title">{s.title}</h3>
          <p class="card-desc">{s.desc}</p>
        </article>
      ))}
    </div>

    <div class="standards-footer">
      <div class="warranty-callout">
        <div class="warranty-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <p><strong>1-Year Comprehensive Builder Warranty + 10-Year Structural Protection</strong> on every {planName ? `${planName} model` : 'Aspen 2 home'}.</p>
      </div>
      <a class="btn btn-ghost" href="/guides/tehachapi-weather-new-home/">Read our Mountain Weather Guide →</a>
    </div>
  </div>
</section>

<style>
  .standards-section {
    background: var(--sand-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(60px, 8vw, 100px) 0;
  }

  .standards-header {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .standards-intro {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 58ch;
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .header-badge {
    background: #fff;
    border: 1px solid var(--line);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    box-shadow: 0 10px 30px rgb(var(--ink-rgb) / 0.04);
  }

  .cslb-tag {
    font-size: 0.72rem;
    color: var(--clay);
    letter-spacing: 0.08em;
  }

  .badge-title {
    font-family: var(--display);
    font-size: 1.35rem;
    color: var(--ink);
  }

  .badge-desc {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .standard-card {
    background: #fff;
    border: 1px solid var(--line);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .standard-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgb(var(--ink-rgb) / 0.08);
    border-color: var(--clay);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--clay);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-tag {
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
    background: var(--sand-2);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 999px;
  }

  .card-title {
    font-family: var(--display);
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }

  .card-desc {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  .standards-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .warranty-callout {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .warranty-icon {
    color: var(--sage);
    display: flex;
    align-items: center;
  }

  @media (max-width: 980px) {
    .standards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .standards-header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .standards-grid {
      grid-template-columns: 1fr;
    }
    .standards-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
