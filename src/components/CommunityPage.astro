---
import Layout from '../layouts/Layout.astro';
import PlanCard from './PlanCard.astro';
import LeadForm from './LeadForm.astro';
import { site, plans, communities, offer, usd, type Community } from '../data/site';
import { breadcrumb, faqPage, webPage } from '../data/schema';

const { community: c } = Astro.props as { community: Community };
const military = c.points.some((p) => p.includes('Heroes'));
const others = communities.filter((x) => x !== c);
const home = c.slug === 'tehachapi-home-builders';
const path = `/${c.slug}/`;
const schema = [
  webPage(path, c.title, c.description, { about: { '@type': 'Place', name: `${c.name}, California` } }),
  breadcrumb([['Home', '/'], ['Communities', '/#communities'], [c.name, path]]),
  faqPage(c.faq),
];
---
<Layout
  title={c.title}
  description={c.description}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <nav class="mono crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/#communities">Communities</a> / <span aria-current="page">{c.name}</span></nav>
      <p class="eyebrow reveal">{home ? 'Where we build' : 'Areas we serve'} · {c.name}, CA</p>
      <h1 class="reveal" style="animation-delay:.1s">{c.h1}</h1>
      <p class="lede reveal" style="animation-delay:.2s">{c.intro}</p>
      <ul class="points reveal" style="animation-delay:.3s">{c.points.map((p) => <li>{p}</li>)}</ul>
      <div class="ctas">
        {home && <a class="btn" href="/sunset-retreat-tehachapi/">See Sunset Retreat availability</a>}
        <a class:list={['btn', { 'btn-ghost': home }]} href="#inquire">{home ? 'Build on your lot' : 'Ask about current availability'}</a>
        {military && <a class="btn btn-ghost" href="/heroes-of-the-nation/">Military program</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{home ? 'Models' : `Models to ask about in ${c.name}`}</p>
      <h2>Six floor plans, <em>ready for your finishes.</em></h2>
      {home && <p class="muted">The current {offer.community} release in Tehachapi uses the {offer.community} model, from {usd(offer.from)}. Ask about building any plan on another lot.</p>}
      <div class="grid">{plans.map((p) => <PlanCard plan={p} />)}</div>
      <p><a class="btn btn-ghost" href="/floor-plans/">Compare all floor plans</a></p>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">{c.name} questions</p>
        <h2>Straight <em>answers.</em></h2>
        <p class="muted">Still have a question? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
      </div>
      <div class="faq">{c.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="section inquire" id="inquire">
    <div class="wrap inq-grid">
      <div>
        <p class="eyebrow">Building in {c.name}?</p>
        <h2>Tell us about <em>your lot.</em></h2>
        <p class="muted">Own land already, or still looking? Either way, we'll walk you through what it takes to build here.</p>
        <p class="mono also">Also serving: {others.map((o, i) => <><a href={`/${o.slug}/`}>{o.name}</a>{i < others.length - 1 && ' · '}</>)}</p>
      </div>
      <LeadForm community={c.name} source={`Community page: ${c.name}`} />
    </div>
  </section>
</Layout>

<style>
  .hero { background: var(--ink); color: var(--bone); padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 110px); }
  .hero .eyebrow, .hero em { color: var(--gold); }
  .crumbs { color: var(--on-dark-muted); font-size: .68rem; margin-bottom: 2.5rem; }
  .crumbs a { text-decoration: none; }
  .hero h1 { max-width: 22ch; font-size: clamp(2.2rem, 5.5vw, 4.2rem); }
  .lede { max-width: 56ch; font-size: 1.2rem; opacity: .9; }
  .points { list-style: none; padding: 0; margin: 2rem 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .points li { border: 1px solid rgb(var(--bone-rgb) / .25); padding: .5em 1em; font: .75rem var(--mono); letter-spacing: .06em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; margin-top: 2rem; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq-grid .muted a { color: var(--clay); }
  .faq details { border-top: 1px solid var(--line); }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 1.1rem 0; font: 1.15rem var(--display); }
  .faq details p { margin: 0 0 1.2rem; color: var(--muted); }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
  .inquire { background: var(--sand-2); }
  .inq-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .also { font-size: .7rem; line-height: 2; margin-top: 2rem; color: var(--muted); }
  .also a { color: var(--clay); }
  @media (max-width: 860px) { .inq-grid { grid-template-columns: 1fr; } }
</style>
