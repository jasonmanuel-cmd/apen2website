---
import { offer, usd } from '../data/site';

const lots = [
  { id: '1', name: 'Homesite 01', model: 'Sunset Retreat Model', status: 'Reserving', sqft: 1715, beds: 3, baths: 2, price: offer.from, notes: 'Phase 1 · Facing Tehachapi Mountain Crest · Move-in ~3 mos' },
  { id: '2', name: 'Homesite 02', model: 'Sunset Retreat Model', status: 'Reserving', sqft: 1715, beds: 3, baths: 2, price: offer.from, notes: 'Phase 1 · Corner Lot · Extended Backyard · Move-in ~3 mos' },
  { id: '3', name: 'Homesite 03', model: 'Custom Model Selection', status: 'Waitlist', sqft: '1,507 - 2,348', beds: '3 - 4', baths: '2 - 2.5', price: null, notes: 'Phase 2 · Elevation Ready · Pre-Release Registration Open' },
  { id: '4', name: 'Homesite 04', model: 'Custom Model Selection', status: 'Waitlist', sqft: '1,507 - 2,348', beds: '3 - 4', baths: '2 - 2.5', price: null, notes: 'Phase 2 · Scenic Ridge View · Pre-Release Registration Open' },
  { id: '5', name: 'Homesite 05', model: 'Custom Model Selection', status: 'Waitlist', sqft: '1,507 - 2,348', beds: '3 - 4', baths: '2 - 2.5', price: null, notes: 'Phase 2 · Cul-de-sac Setting · Pre-Release Registration Open' },
  { id: '6', name: 'Homesite 06', model: 'Custom Model Selection', status: 'Waitlist', sqft: '1,507 - 2,348', beds: '3 - 4', baths: '2 - 2.5', price: null, notes: 'Phase 2 · Sunset Facing · Pre-Release Registration Open' },
];
---

<div class="plat-map-section" data-plat-map>
  <div class="plat-head">
    <div>
      <p class="plat-kicker mono">Phase 1 &amp; 2 Release Map</p>
      <h3>{offer.community} Interactive Homesite Plat</h3>
    </div>
    <div class="plat-legend mono">
      <span class="legend-item"><span class="dot live"></span> Now Reserving (Phase 1)</span>
      <span class="legend-item"><span class="dot wait"></span> Phase 2 Waitlist</span>
    </div>
  </div>

  <div class="plat-layout">
    <!-- Interactive SVG Plat Map -->
    <div class="plat-canvas-wrap">
      <svg viewBox="0 0 800 480" class="plat-svg" aria-label="Sunset Retreat Plat Map">
        <defs>
          <linearGradient id="roadGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1B3A10" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#10280B" stop-opacity="0.2" />
          </linearGradient>
          <pattern id="contourPattern" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M0 30 Q 30 10, 60 30" fill="none" stroke="#10280B" stroke-opacity="0.04" stroke-width="1" />
          </pattern>
        </defs>

        <!-- Background Topography -->
        <rect width="100%" height="100%" fill="url(#contourPattern)" rx="8" />

        <!-- Access Road & Cul-de-sac -->
        <path d="M 0 240 L 520 240 Q 640 240, 640 240" fill="none" stroke="url(#roadGrad)" stroke-width="56" stroke-linecap="round" />
        <circle cx="640" cy="240" r="70" fill="url(#roadGrad)" />
        <text x="140" y="246" font-family="var(--mono)" font-size="11" fill="var(--muted)" letter-spacing="3" opacity="0.7">SUNSET RETREAT WAY</text>

        <!-- Lot 1 (Phase 1 Reserving) -->
        <g class="lot-node active" data-lot-id="1" tabindex="0" role="button" aria-label="Homesite 1, Sunset Retreat Model, Now Reserving">
          <polygon points="60,60 260,60 260,200 60,200" class="lot-poly lot-live" />
          <text x="160" y="115" class="lot-num mono">LOT 01</text>
          <text x="160" y="140" class="lot-state mono">RESERVING</text>
          <circle cx="235" cy="85" r="5" class="lot-pulse-dot" />
        </g>

        <!-- Lot 2 (Phase 1 Reserving) -->
        <g class="lot-node" data-lot-id="2" tabindex="0" role="button" aria-label="Homesite 2, Sunset Retreat Model, Now Reserving">
          <polygon points="280,60 480,60 480,200 280,200" class="lot-poly lot-live" />
          <text x="380" y="115" class="lot-num mono">LOT 02</text>
          <text x="380" y="140" class="lot-state mono">RESERVING</text>
          <circle cx="455" cy="85" r="5" class="lot-pulse-dot" />
        </g>

        <!-- Lot 3 (Phase 2 Waitlist) -->
        <g class="lot-node" data-lot-id="3" tabindex="0" role="button" aria-label="Homesite 3, Phase 2 Waitlist">
          <polygon points="500,60 700,60 700,180 560,200 500,200" class="lot-poly lot-wait" />
          <text x="600" y="115" class="lot-num mono">LOT 03</text>
          <text x="600" y="140" class="lot-state mono">PHASE 2</text>
        </g>

        <!-- Lot 4 (Phase 2 Waitlist - South East) -->
        <g class="lot-node" data-lot-id="4" tabindex="0" role="button" aria-label="Homesite 4, Phase 2 Waitlist">
          <polygon points="500,280 560,280 700,300 700,420 500,420" class="lot-poly lot-wait" />
          <text x="600" y="345" class="lot-num mono">LOT 04</text>
          <text x="600" y="370" class="lot-state mono">PHASE 2</text>
        </g>

        <!-- Lot 5 (Phase 2 Waitlist - South Center) -->
        <g class="lot-node" data-lot-id="5" tabindex="0" role="button" aria-label="Homesite 5, Phase 2 Waitlist">
          <polygon points="280,280 480,280 480,420 280,420" class="lot-poly lot-wait" />
          <text x="380" y="345" class="lot-num mono">LOT 05</text>
          <text x="380" y="370" class="lot-state mono">PHASE 2</text>
        </g>

        <!-- Lot 6 (Phase 2 Waitlist - South West) -->
        <g class="lot-node" data-lot-id="6" tabindex="0" role="button" aria-label="Homesite 6, Phase 2 Waitlist">
          <polygon points="60,280 260,280 260,420 60,420" class="lot-poly lot-wait" />
          <text x="160" y="345" class="lot-num mono">LOT 06</text>
          <text x="160" y="370" class="lot-state mono">PHASE 2</text>
        </g>
      </svg>
    </div>

    <!-- Active Lot Details Card -->
    <div class="plat-card" data-plat-card>
      <div class="plat-card-badge-row">
        <span class="plat-badge mono" data-card-status>Now Reserving</span>
        <span class="plat-phase mono">Sunset Retreat · Phase 1</span>
      </div>
      <h4 class="plat-card-title" data-card-title>Homesite 01</h4>
      <p class="plat-card-model" data-card-model>Sunset Retreat Model</p>
      <p class="plat-card-notes muted" data-card-notes>Phase 1 · Facing Tehachapi Mountain Crest · Move-in ~3 mos</p>

      <div class="plat-card-specs mono">
        <div>
          <span class="muted">Specs</span>
          <strong data-card-specs>1,715 sq ft · 3 Bed · 2 Bath</strong>
        </div>
        <div>
          <span class="muted">Pricing</span>
          <strong class="text-gold" data-card-price>From {usd(offer.from)}</strong>
        </div>
      </div>

      <div class="plat-card-action">
        <a href="/contact/?interest=reserve#form" class="btn btn-full" data-card-cta>Reserve This Homesite →</a>
      </div>
    </div>
  </div>
</div>

<style>
  .plat-map-section {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    margin: 3.5rem 0;
  }
  .plat-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .plat-kicker { font-size: .74rem; color: var(--rust); text-transform: uppercase; letter-spacing: .12em; margin: 0 0 .3rem; }
  .plat-head h3 { font-family: var(--display); font-size: clamp(1.7rem, 3.2vw, 2.3rem); color: var(--ink); margin: 0; line-height: 1.15; }
  .plat-legend { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .74rem; color: var(--muted); }
  .legend-item { display: inline-flex; align-items: center; gap: .5rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot.live { background: #62E755; box-shadow: 0 0 8px #62E755; }
  .dot.wait { background: var(--muted); opacity: .6; }

  .plat-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .plat-canvas-wrap {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: inset 0 2px 8px rgb(0 0 0 / .04);
  }
  .plat-svg { width: 100%; height: auto; display: block; }

  /* Lot Polygons */
  .lot-node { cursor: pointer; outline: none; transition: transform .2s ease; }
  .lot-poly {
    transition: fill .25s ease, stroke .25s ease, stroke-width .25s ease;
    stroke-width: 2;
  }
  .lot-live { fill: rgb(14 74 6 / .1); stroke: var(--clay); }
  .lot-wait { fill: rgb(16 40 11 / .03); stroke: var(--line); }

  .lot-node:hover .lot-live, .lot-node.active .lot-live {
    fill: rgb(14 74 6 / .24);
    stroke: var(--clay);
    stroke-width: 3;
  }
  .lot-node:hover .lot-wait, .lot-node.active .lot-wait {
    fill: rgb(201 138 0 / .15);
    stroke: var(--gold);
    stroke-width: 3;
  }

  .lot-num {
    text-anchor: middle;
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
    pointer-events: none;
  }
  .lot-state {
    text-anchor: middle;
    font-size: 10px;
    letter-spacing: 1.5px;
    fill: var(--muted);
    pointer-events: none;
  }
  .lot-pulse-dot { fill: #62E755; animation: pulse 1.6s infinite; }

  /* Details Card */
  .plat-card {
    background: var(--bone);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
    box-shadow: 0 12px 30px rgb(var(--ink-rgb) / .08);
  }
  .plat-card-badge-row { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-size: .72rem; }
  .plat-badge { background: var(--clay); color: var(--bone); padding: .3em .75em; border-radius: 2px; }
  .plat-phase { color: var(--rust); }
  .plat-card-title { font-family: var(--display); font-size: 2rem; color: var(--ink); margin: 0; line-height: 1.1; }
  .plat-card-model { font-size: 1.05rem; font-weight: 500; color: var(--ink); margin: 0; }
  .plat-card-notes { font-size: .88rem; line-height: 1.5; margin: 0; }

  .plat-card-specs {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    font-size: .82rem;
    margin: .5rem 0;
  }
  .plat-card-specs div { display: flex; flex-direction: column; gap: .25rem; }
  .plat-card-specs strong { color: var(--ink); font-size: .95rem; }
  .plat-card-specs .text-gold { color: var(--rust); font-family: var(--display); font-size: 1.1rem; }

  .btn-full { width: 100%; justify-content: center; min-height: 48px; }

  @media (max-width: 900px) {
    .plat-layout { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ lots }}>
  function initPlatMap() {
    const root = document.querySelector('[data-plat-map]');
    if (!root || root.__hasPlat) return;
    root.__hasPlat = true;

    const nodes = root.querySelectorAll('[data-lot-id]');
    const statusEl = root.querySelector('[data-card-status]');
    const titleEl = root.querySelector('[data-card-title]');
    const modelEl = root.querySelector('[data-card-model]');
    const notesEl = root.querySelector('[data-card-notes]');
    const specsEl = root.querySelector('[data-card-specs]');
    const priceEl = root.querySelector('[data-card-price]');
    const ctaEl = root.querySelector('[data-card-cta]');

    function selectLot(id) {
      const lot = lots.find((l) => l.id === id);
      if (!lot) return;

      nodes.forEach((n) => n.classList.toggle('active', n.dataset.lotId === id));

      if (statusEl) {
        statusEl.textContent = lot.status === 'Reserving' ? '● Now Reserving' : 'Phase 2 Waitlist';
        statusEl.style.background = lot.status === 'Reserving' ? 'var(--clay)' : 'var(--muted)';
      }
      if (titleEl) titleEl.textContent = lot.name;
      if (modelEl) modelEl.textContent = lot.model;
      if (notesEl) notesEl.textContent = lot.notes;
      if (specsEl) specsEl.textContent = `${lot.sqft} sq ft · ${lot.beds} Bed · ${lot.baths} Bath`;
      if (priceEl) priceEl.textContent = lot.price ? `From $${lot.price.toLocaleString()}` : 'Join Waitlist';
      if (ctaEl) {
        ctaEl.textContent = lot.status === 'Reserving' ? `Reserve ${lot.name} →` : `Join ${lot.name} Waitlist →`;
        ctaEl.href = `/contact/?interest=reserve#form`;
      }
    }

    nodes.forEach((node) => {
      node.addEventListener('click', () => selectLot(node.dataset.lotId));
      node.addEventListener('mouseenter', () => selectLot(node.dataset.lotId));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPlatMap);
  } else {
    initPlatMap();
  }
</script>
