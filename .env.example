# Lead storage and emails from the website form (api/lead.js). Set these in Vercel:
# Project > Settings > Environment Variables. Never commit real keys.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Where new leads are sent. Comma-separate for several people.
# Before the domain is verified in Resend, this MUST be the email you signed up to Resend with.
NOTIFICATION_EMAIL=Aspen2homes@gmail.com

# Sender. Keep the default until the domain is verified in Resend (Domains > Add domain),
# then switch to e.g.: Aspen II Homes <leads@aspen2homes.com>
RESEND_FROM=Aspen II Homes <leads@aspen2homes.com>

# Supabase project for the leads table (project aspen2-leads). Server-side only.
# SUPABASE_URL is the project's API URL (Dashboard > Project Settings > API).
# SUPABASE_SERVICE_ROLE_KEY is the secret / service_role key from the same page. It bypasses row
# level security, so keep it in Vercel env vars only: never commit it, never expose it to the browser.
# Without both, the form still emails leads but stores nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Locks /api/keepalive (the daily Supabase keep-alive cron) so only Vercel's cron job can run it.
# Any long random string works. Vercel sends it automatically when this variable exists.
CRON_SECRET=

# Staff lead inbox (/staff/) and the HQ dashboard (/hq/). The password staff type to open either one.
# Use a long random string (at least 20 characters; the endpoints stay closed if it is shorter or missing).
# Set it in Vercel env vars only. Rotate it by changing the value and redeploying.
STAFF_TOKEN=

# Traffic analytics (public/analytics.js -> /api/track -> /hq/). Optional but strongly recommended:
# without a value the site falls back to a fixed one, which still rotates daily but means two sites
# sharing a default salt could be correlated. Any long random string; set once and leave it alone.
# Changing it invalidates previously stored visitor hashes, so unique counts will dip for a day.
ANALYTICS_SALT=

# Website chat assistant (api/chat.js, widget on every page, staff view in /hq > Chats / Appointments).
# Create a key at https://console.anthropic.com/ . Without it the chat widget tells visitors to call the office.
# Also run supabase/chat-schema.sql once in the Supabase SQL editor. Server-side only: never commit the key.
ANTHROPIC_API_KEY=
# Optional. The model that writes replies. Default is a small, fast, low-cost one.
CHAT_MODEL=claude-haiku-5-5

# Text-message auto-reply through Google Voice (api/sms.js + scripts/google-voice-bridge.gs, see docs/google-voice-bridge.md).
# A long random string (20+ characters). Put the SAME value in the Apps Script property BRIDGE_SECRET.
# Without it the endpoint refuses everything.
SMS_BRIDGE_SECRET=
